<UserControl x:Class="VisionEditControl.RoiImageEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" 
             d:DesignWidth="600">
    <Border BorderBrush="#444" BorderThickness="1" Background="#1E1E1E">
        <Grid>
            <!-- 图片 -->
            <Image x:Name="imgMain"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- 交互覆盖层 -->
            <Canvas x:Name="overlayCanvas"
                    Background="Transparent"
                    ClipToBounds="True"
                    MouseDown="OverlayCanvas_MouseDown"
                    MouseMove="OverlayCanvas_MouseMove"
                    MouseUp="OverlayCanvas_MouseUp"
                    MouseLeave="OverlayCanvas_MouseLeave"
                    Cursor="Cross">

                <!-- 遮罩：整个画布暗色 + ROI 区域挖空(支持旋转) -->
                <Path Fill="#88000000" IsHitTestVisible="False">
                    <Path.Data>
                        <CombinedGeometry x:Name="maskGeometry" GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <RectangleGeometry x:Name="fullRectGeo" />
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <RectangleGeometry x:Name="roiHoleGeo" />
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </Path.Data>
                </Path>

                <!-- ROI 矩形 -->
                <Rectangle x:Name="roiRect"
                           Stroke="#00BFFF"
                           StrokeThickness="2"
                           StrokeDashArray="6,3"
                           Fill="#1A00BFFF"
                           Visibility="Collapsed" />

                <!-- 旋转手柄连接线 -->
                <Line x:Name="rotateLine"
                      Stroke="#FFD700"
                      StrokeThickness="1.5"
                      StrokeDashArray="3,3"
                      Visibility="Collapsed"
                      IsHitTestVisible="False" />

                <!-- 旋转手柄（圆形拖拽点） -->
                <Ellipse x:Name="rotateHandle"
                         Width="14" Height="14"
                         Fill="#FFD700"
                         Stroke="White"
                         StrokeThickness="1.5"
                         Cursor="Hand"
                         Visibility="Collapsed" />

                <!-- 8个缩放手柄 -->
                <Rectangle x:Name="handleTL" Width="8" Height="8" Fill="#00BFFF" Stroke="White" StrokeThickness="1" Visibility="Collapsed" Cursor="SizeNWSE" />
                <Rectangle x:Name="handleTC" Width="8" Height="8" Fill="#00BFFF" Stroke="White" StrokeThickness="1" Visibility="Collapsed" Cursor="SizeNS" />
                <Rectangle x:Name="handleTR" Width="8" Height="8" Fill="#00BFFF" Stroke="White" StrokeThickness="1" Visibility="Collapsed" Cursor="SizeNESW" />
                <Rectangle x:Name="handleML" Width="8" Height="8" Fill="#00BFFF" Stroke="White" StrokeThickness="1" Visibility="Collapsed" Cursor="SizeWE" />
                <Rectangle x:Name="handleMR" Width="8" Height="8" Fill="#00BFFF" Stroke="White" StrokeThickness="1" Visibility="Collapsed" Cursor="SizeWE" />
                <Rectangle x:Name="handleBL" Width="8" Height="8" Fill="#00BFFF" Stroke="White" StrokeThickness="1" Visibility="Collapsed" Cursor="SizeNESW" />
                <Rectangle x:Name="handleBC" Width="8" Height="8" Fill="#00BFFF" Stroke="White" StrokeThickness="1" Visibility="Collapsed" Cursor="SizeNS" />
                <Rectangle x:Name="handleBR" Width="8" Height="8" Fill="#00BFFF" Stroke="White" StrokeThickness="1" Visibility="Collapsed" Cursor="SizeNWSE" />

                <!-- 坐标显示标签 -->
                <Border x:Name="coordBorder"
                        Background="#CC000000"
                        CornerRadius="3"
                        Padding="6,3"
                        Visibility="Collapsed">
                    <TextBlock x:Name="txtCoord"
                               Foreground="#00FF00"
                               FontFamily="Consolas"
                               FontSize="12" />
                </Border>

                <!-- ROI 信息标签 -->
                <Border x:Name="roiInfoBorder"
                        Background="#CC000000"
                        CornerRadius="3"
                        Padding="6,3"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="txtRoiInfo"
                               Foreground="#00BFFF"
                               FontFamily="Consolas"
                               FontSize="12" />
                </Border>

            </Canvas>
        </Grid>
    </Border>
</UserControl>
