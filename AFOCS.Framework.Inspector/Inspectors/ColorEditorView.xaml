<UserControl x:Class="AFOCS.Framework.Inspector.Inspectors.ColorEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:toolkit="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:p="AFOCS.Framework.Inspector.Properties"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:markup="clr-namespace:AFOCS.Framework.Framework.Markup;assembly=AFOCS.Framework"
             xmlns:controls="clr-namespace:AFOCS.Framework.Inspector.Controls"
             mc:Ignorable="d">
    <StackPanel Orientation="Horizontal">
        <toolkit:ColorPicker SelectedColor="{Binding Value}"
                             UsingAlphaChannel="{Binding UsingAlphaChannel}"
                             HorizontalAlignment="Left"
                             Height="23" Width="70"
                             StandardColorsHeader="{markup:Translate p:Resources.ColorEditorStandardColors}"
                             StandardTabHeader="{markup:Translate p:Resources.ColorEditorStandard}"
                             RecentColorsHeader="{markup:Translate p:Resources.ColorEditorRecentColors}"
                             AvailableColorsHeader="{markup:Translate p:Resources.ColorEditorAvailableColors}"
                             AdvancedTabHeader="{markup:Translate p:Resources.ColorEditorAdvanced}"
                             cal:Message.Attach="[Event Closed] = [Action Closed]; [Event Opened] = [Action Opened]" />
        <controls:ScreenColorPicker x:Name="ScreenColorPicker" Margin="3 0 0 0"
                                 PickingStarted="OnScreenColorPickerPickingStarted"
                                 PickingCancelled="OnScreenColorPickerPickingCancelled"
								 ColorHovered="OnScreenColorPickerColorHovered"
								 ColorPicked="OnScreenColorPickerColorPicked" />
    </StackPanel>
</UserControl>
