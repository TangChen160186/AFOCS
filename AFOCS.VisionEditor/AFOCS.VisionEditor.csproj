<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="Nodify" />
    <PackageReference Include="Caliburn.Micro" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="DotNetProjects.Extended.Wpf.Toolkit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AFOCS.FlowNodeEditor\AFOCS.FlowNodeEditor.csproj" />
    <ProjectReference Include="..\AFOCS.Framework\AFOCS.Framework.csproj" />
    <ProjectReference Include="..\AFOCS.Infrastructure\AFOCS.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnet">
      <HintPath>..\Vendor\HalconDll\halcondotnet.dll</HintPath>
    </Reference>
    <Reference Include="hdevenginedotnet">
      <HintPath>..\Vendor\HalconDll\hdevenginedotnet.dll</HintPath>
    </Reference>
  </ItemGroup>
    <Target Name="CopyHalconDll" BeforeTargets="Build">
        <PropertyGroup>
            <SolutionDir>$(SolutionDir)</SolutionDir>
        </PropertyGroup>
        <Copy SourceFiles="$(SolutionDir)Vendor\HalconDll\halcondotnet.dll" DestinationFolder="$(MainOutput)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="Exists('$(SolutionDir)Vendor\HalconDll\halcondotnet.dll')" />
        <Copy SourceFiles="$(SolutionDir)Vendor\HalconDll\hdevenginedotnet.dll" DestinationFolder="$(MainOutput)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="Exists('$(SolutionDir)Vendor\HalconDll\hdevenginedotnet.dll')" />
      
    </Target>
</Project>
