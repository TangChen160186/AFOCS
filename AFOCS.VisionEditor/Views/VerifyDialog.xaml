<Window x:Class="AFOCS.VisionEditor.Views.VerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AFOCS.VisionEditor.Views"
        xmlns:halconDotNet="clr-namespace:HalconDotNet;assembly=halcondotnet"
        Title="视觉模板验证" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888" />
        <SolidColorBrush x:Key="SuccessColor" Color="#2E7D32" />
        <SolidColorBrush x:Key="FailColor" Color="#D32F2F" />
        <local:InvertBoolConverter x:Key="InvertBoolConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Border Grid.Row="0" Background="#FAFAFA" Padding="8,6"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="加载图片" Command="{Binding SelectImageCommand}"
                        Padding="16,6" Margin="0,0,8,0"
                        Background="#FFFFFF" Foreground="#333" BorderBrush="#CCC"
                        BorderThickness="1" />
                <Button Content="执行" Command="{Binding VerifyCommand}"
                        Padding="16,6" FontWeight="Bold"
                        Background="#1976D2" Foreground="White" BorderThickness="0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
            </StackPanel>
        </Border>

        <!-- ===== 图像显示区 ===== -->
        <Grid Grid.Row="1" Background="#FFFFFF">
            <halconDotNet:HSmartWindowControlWPF x:Name="hSmartVerify"
                                                  Loaded="HSmartVerify_OnLoaded" />
        </Grid>

        <!-- ===== 结果条 ===== -->
        <Border Grid.Row="2" Background="#FAFAFA" Padding="10,6"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <!-- NCC -->
                <Border Padding="6,2" Margin="0,0,12,0" CornerRadius="2"
                        Visibility="{Binding ShowNcc, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding NccText}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NccOk}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NccOk}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource FailColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <!-- Edge1 -->
                <Border Padding="6,2" Margin="0,0,12,0" CornerRadius="2"
                        Visibility="{Binding ShowEdge1, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding Edge1Text}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Edge1Ok}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Edge1Ok}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource FailColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <!-- Edge2 -->
                <Border Padding="6,2" Margin="0,0,12,0" CornerRadius="2"
                        Visibility="{Binding ShowEdge2, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding Edge2Text}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Edge2Ok}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Edge2Ok}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource FailColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <!-- Point -->
                <Border Padding="6,2" CornerRadius="2"
                        Visibility="{Binding ShowPoint, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding PointText}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PointOk}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PointOk}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource FailColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
