<UserControl x:Class="AFOCS.VisionEditor.Views.VisionEditorDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:AFOCS.VisionEditor.ViewModels"
             xmlns:edit="clr-namespace:VisionEditControl;assembly=VisionEditControl"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:local="clr-namespace:AFOCS.VisionEditor.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VisionEditorDocumentViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Light theme colors -->
        <SolidColorBrush x:Key="PanelBg" Color="#F5F5F5" />
        <SolidColorBrush x:Key="PanelBorder" Color="#DDDDDD" />
        <SolidColorBrush x:Key="ProcessEnabledBg" Color="#E8F5E9" />
        <SolidColorBrush x:Key="ProcessDisabledBg" Color="#F0F0F0" />
        <SolidColorBrush x:Key="ProcessSelectedBorder" Color="#1976D2" />
        <SolidColorBrush x:Key="ToolbarBg" Color="#FAFAFA" />
        <SolidColorBrush x:Key="TextPrimary" Color="#333333" />
        <SolidColorBrush x:Key="TextSecondary" Color="#888888" />

        <!-- Converters -->
        <local:InvertBoolConverter x:Key="InvertBoolConverter" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibilityConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:NccToVisibilityConverter x:Key="NccToVisibilityConverter" />

        <!-- Process item style -->
        <Style x:Key="ProcessItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ProcessEnabledBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Background" Value="{StaticResource ProcessDisabledBg}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ProcessSelectedBorder}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部工具栏 ===== -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBg}" Padding="8,6"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="选择图片" Command="{Binding SelectImageCommand}"
                            Padding="12,4" Margin="0,0,8,0"
                            Background="#FFFFFF" Foreground="#333" BorderBrush="#CCC"
                            BorderThickness="1" />
                    <TextBlock Text="{Binding ImagePath}" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" MaxWidth="300"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="验证" Command="{Binding VerifyCommand}"
                            Padding="12,6" Margin="0,0,8,0"
                            Background="#FFFFFF" Foreground="#333" BorderBrush="#CCC"
                            BorderThickness="1"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
                    <Button Content="▶ 执行" Command="{Binding ExecuteCommand}"
                            Padding="16,6" FontSize="14" FontWeight="Bold"
                            Background="#1976D2" Foreground="White" BorderThickness="0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体：三栏布局 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- === 左侧：流程列表 === -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="视觉流程" Foreground="{StaticResource TextSecondary}"
                               FontSize="13" FontWeight="Bold" Margin="16,12,4,8" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Processes}"
                             SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ProcessItemStyle}"
                             Background="Transparent" BorderThickness="0" Margin="4,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsEnabled}"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               FontSize="14" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- === 中间：图像编辑区 === -->
            <Grid Grid.Column="1" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- NCC ROI 切换条 -->
                <Border Grid.Row="0" Background="{StaticResource ToolbarBg}" Padding="8,4"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1"
                        Visibility="{Binding SelectedProcessType, Converter={StaticResource NccToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="搜索范围"
                                      IsChecked="{Binding IsEditingTemplateRoi, Converter={StaticResource InvertBoolConverter}}"
                                      Padding="12,4" Margin="0,0,4,0"
                                      Background="#FFFFFF" Foreground="#333" BorderBrush="#CCC" BorderThickness="1" />
                        <ToggleButton Content="模板范围"
                                      IsChecked="{Binding IsEditingTemplateRoi}"
                                      Padding="12,4"
                                      Background="#FFFFFF" Foreground="#333" BorderBrush="#CCC" BorderThickness="1" />
                    </StackPanel>
                </Border>

                <edit:RoiImageEditor Grid.Row="1"
                                     x:Name="RoiEditor"
                                     ImageSource="{Binding DisplayImage}"
                                     RoiRect="{Binding EditorRoiRect, Mode=TwoWay}"
                                     RotationAngle="{Binding EditorRoiAngle, Mode=TwoWay}" />
            </Grid>

            <!-- === 右侧：PropertyGrid + 结果预览 === -->
            <Border Grid.Column="2" Background="White"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    
                    </Grid.RowDefinitions>


                    <!-- 未选中提示 / PropertyGrid -->
                    <TextBlock Grid.Row="1" Text="选择左侧流程以编辑参数"
                               Foreground="{StaticResource TextSecondary}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsProcessSelected, Converter={StaticResource InvertBoolToVisibilityConverter}}" />

                    <xctk:PropertyGrid Grid.Row="1"
                                       SelectedObject="{Binding SelectedConfigObject}"
                                       ShowTitle="False"
                                       ShowSortOptions="False"
                                       ShowSearchBox="False"
                                       Background="White" Foreground="#333"
                                       BorderThickness="0"
                                       Visibility="{Binding IsProcessSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

                

                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.Row="2" Background="{StaticResource ToolbarBg}" Padding="10,5"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding ExecutionStatus}" FontSize="12"
                       Foreground="{StaticResource TextSecondary}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasExecutionError}" Value="True">
                                <Setter Property="Foreground" Value="#D32F2F" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasExecutionError}" Value="False">
                                <Setter Property="Foreground" Value="#2E7D32" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
