<UserControl x:Class="AFOCS.FlowNodeEditor.Views.NodeToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:AFOCS.Framework.Framework.Controls;assembly=AFOCS.Framework"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="250">

    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedItems" Source="{Binding FilteredToolboxItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索框 -->
        <TextBox x:Name="SearchBox" Grid.Row="0" Margin="4"
                 Text="{Binding ToolboxSearchText, UpdateSourceTrigger=PropertyChanged}" />

        <!-- 分组列表 -->
        <ListBox x:Name="ToolboxListBox" Grid.Row="1"
                 ItemsSource="{Binding Source={StaticResource GroupedItems}}"
                 Background="Transparent" BorderThickness="0"
                 PreviewMouseLeftButtonDown="OnListBoxPreviewMouseLeftButtonDown"
                 MouseMove="OnListBoxMouseMove">

            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <controls:ExpanderEx Header="{Binding Name}" IsExpanded="True">
                                            <ItemsPresenter />
                                        </controls:ExpanderEx>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListBox.GroupStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" Cursor="SizeAll">
                        <Image Source="{Binding IconSource}"
                               Margin="0,0,5,0" Width="16" Height="16" />
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource EnvironmentToolWindowText}"
                                   Padding="2" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
