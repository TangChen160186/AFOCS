<UserControl x:Class="AFOCS.FlowNodeEditor.Views.NodePropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AFOCS.FlowNodeEditor.ViewModels"
             xmlns:Converters="clr-namespace:AFOCS.FlowNodeEditor.Converters"
             xmlns:controls="clr-namespace:AFOCS.Framework.Framework.Controls;assembly=AFOCS.Framework"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <UserControl.Resources>
        <ResourceDictionary>
            <Converters:NullToVisibilityConverter x:Key="NullToVis" />
            <Converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource FlowNode.HeaderBackground}"
                Padding="8,6"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="属性面板"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource FlowNode.HeaderText}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ExecutionStatus}"
                           Foreground="{DynamicResource FlowNode.AccentText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="8,0,0,0" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SelectedNode, Converter={StaticResource NullToVis}}">
            <StackPanel Margin="8,4">

                <Button Content="执行流程"
                        Command="{Binding ExecuteCommand}"
                        Margin="0,0,0,8" />

                <xctk:PropertyGrid x:Name="propertyGrid"
                                   Margin="8,4"
                                   AutoGenerateProperties="True"
                                   BorderBrush="{DynamicResource FlowNode.Border}"
                                   Background="{DynamicResource EnvironmentWindowBackground}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>