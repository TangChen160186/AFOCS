<UserControl x:Class="AFOCS.FlowNodeEditor.Views.NodePropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AFOCS.FlowNodeEditor.ViewModels"
             xmlns:Converters="clr-namespace:AFOCS.FlowNodeEditor.Converters"
             xmlns:controls="clr-namespace:AFOCS.Framework.Framework.Controls;assembly=AFOCS.Framework">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 引用 Inspector 共享资源字典：编辑器模板、选择器、布局模板 -->
                <ResourceDictionary Source="/AFOCS.FlowNodeEditor;component/NodeInspectors/NodeInspectorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 视图级转换器 -->
            <Converters:NullToVisibilityConverter x:Key="NullToVis" />
            <Converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ========== 主布局 ========== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource FlowNode.HeaderBackground}"
                Padding="8,6"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="属性面板"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource FlowNode.HeaderText}"
                           VerticalAlignment="Center" />
                <!-- 执行状态指示 -->
                <TextBlock Grid.Column="1"
                           Text="{Binding ExecutionStatus}"
                           Foreground="{DynamicResource FlowNode.AccentText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- ===== 属性内容 ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SelectedNode, Converter={StaticResource NullToVis}}">
            <StackPanel Margin="8,4">

                <!-- ===== 执行按钮 ===== -->
                <Button Content="执行流程"
                        Command="{Binding ExecuteCommand}"
                        Margin="0,0,0,8" />

                <!-- ===== 节点基本属性 ===== -->
                <controls:ExpanderEx Header="节点信息" IsExpanded="True">
                    <StackPanel Margin="8,4">
                        <!-- 标题 -->
                        <TextBlock Text="标题"
                                   Foreground="{DynamicResource EnvironmentToolWindowText}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedNode.Title, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" />

                        <!-- 位置 -->
                        <TextBlock Text="位置"
                                   Foreground="{DynamicResource EnvironmentToolWindowText}"
                                   Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X:"
                                       Foreground="{DynamicResource FlowNode.SubtleText}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedNode.Location.X, StringFormat=F0}" />
                            <TextBlock Grid.Column="2" Text="Y:"
                                       Foreground="{DynamicResource FlowNode.SubtleText}"
                                       VerticalAlignment="Center" Margin="8,0,4,0" />
                            <TextBox Grid.Column="3"
                                     Text="{Binding SelectedNode.Location.Y, StringFormat=F0}" />
                        </Grid>

                        <!-- 节点类型 -->
                        <TextBlock Text="节点类型"
                                   Foreground="{DynamicResource EnvironmentToolWindowText}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SelectedNode.Definition.DisplayName}"
                                   Foreground="{DynamicResource FlowNode.AccentText}"
                                   Margin="0,0,0,4" />
                    </StackPanel>
                </controls:ExpanderEx>

                <!-- ===== 节点参数（Inspector 风格属性编辑） ===== -->
                <controls:ExpanderEx Header="参数" IsExpanded="True" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding SelectedNode.PropertyItems}"
                                  ItemTemplate="{StaticResource LabelledInspectorTemplate}"
                                  Margin="8,4" />
                </controls:ExpanderEx>

                <!-- ===== 端口信息 ===== -->
                <controls:ExpanderEx Header="端口信息" IsExpanded="False" Margin="0,8,0,0">
                    <StackPanel Margin="8,4">
                        <TextBlock Text="输入端口"
                                   Foreground="{DynamicResource EnvironmentToolWindowText}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding SelectedNode.Inputs}"
                                      ItemTemplate="{StaticResource ConnectorInfoTemplate}" />

                        <TextBlock Text="输出端口"
                                   Foreground="{DynamicResource EnvironmentToolWindowText}"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,4" />
                        <ItemsControl ItemsSource="{Binding SelectedNode.Outputs}"
                                      ItemTemplate="{StaticResource ConnectorInfoTemplate}" />
                    </StackPanel>
                </controls:ExpanderEx>

                <!-- ===== 删除节点 ===== -->
                <Button Content="删除节点"
                        Command="{Binding DeleteSelectedNodeCommand}"
                        Margin="0,12,0,0"
                        Height="30" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 未选中节点提示 ===== -->
        <TextBlock Grid.Row="1"
                   Text="请选择一个节点查看属性"
                   Foreground="{DynamicResource FlowNode.SubtleText}"
                   Margin="8,8"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding SelectedNode, Converter={StaticResource NullToCollapsed}}" />
    </Grid>
</UserControl>
