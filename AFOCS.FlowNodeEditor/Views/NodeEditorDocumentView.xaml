<UserControl x:Class="AFOCS.FlowNodeEditor.Views.NodeEditorDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:vm="clr-namespace:AFOCS.FlowNodeEditor.ViewModels"
             xmlns:local="clr-namespace:AFOCS.FlowNodeEditor.Views">

    <UserControl.Resources>
        <!-- ItemContainer 样式：同步选中状态和位置 -->
        <Style TargetType="{x:Type nodify:ItemContainer}" x:Key="SelectableContainerStyle">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：工具箱 -->
        <local:NodeToolboxView x:Name="Toolbox" Grid.Column="0" />

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

        <!-- 中间：节点编辑器 -->
        <Grid Grid.Column="2" Background="{DynamicResource EnvironmentWindowBackground}">
            <nodify:NodifyEditor
                x:Name="Editor"
                Background="{DynamicResource EnvironmentWindowBackground}"
                ItemsSource="{Binding Nodes}"
                Connections="{Binding Connections}"
                ItemContainerStyle="{StaticResource SelectableContainerStyle}"
                ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                SelectedConnection="{Binding SelectedConnection, Mode=TwoWay}"
                ConnectionCompletedCommand="{Binding ConnectionCompletedCommand}"
                DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                AllowDrop="True"
                Drop="Editor_OnDrop"
                Loaded="Editor_OnLoaded">

                <!-- ===== 编辑器内部资源：连接器样式 ===== -->
                <nodify:NodifyEditor.Resources>
                    <!-- 输入连接器样式 -->
                    <Style TargetType="{x:Type nodify:NodeInput}">
                        <Setter Property="Header" Value="{Binding DisplayName}" />
                        <Setter Property="IsConnected" Value="{Binding IsConnected}" />
                        <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
                        <Setter Property="Background"
                                Value="{DynamicResource FlowNode.ConnectorStroke}" />
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource FlowNode.ConnectorStroke}"
                                               FontSize="11"
                                               Margin="4,0" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- 输出连接器样式 -->
                    <Style TargetType="{x:Type nodify:NodeOutput}">
                        <Setter Property="Header" Value="{Binding DisplayName}" />
                        <Setter Property="IsConnected" Value="{Binding IsConnected}" />
                        <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
                        <Setter Property="Background"
                                Value="{DynamicResource FlowNode.ConnectorStroke}" />
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource FlowNode.ConnectorStroke}"
                                               FontSize="11"
                                               Margin="4,0" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </nodify:NodifyEditor.Resources>

                <!-- ===== 节点 DataTemplate ===== -->
                <nodify:NodifyEditor.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                        <Grid>
                            <Border Background="{DynamicResource FlowNode.Background}"
                                    BorderBrush="{DynamicResource FlowNode.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="140"
                                    Padding="0">
                                <StackPanel>
                                    <!-- 标题栏 -->
                                    <Border Background="{DynamicResource FlowNode.HeaderBackground}"
                                            CornerRadius="6,6,0,0"
                                            Padding="10,6">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource FlowNode.HeaderText}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                    </Border>

                                    <!-- 主体：输入在左，输出在右，中间伸展 -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 输入连接器（左侧） -->
                                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Inputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                                    <nodify:NodeInput />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 输出连接器（右侧） -->
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Outputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                                    <nodify:NodeOutput />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </nodify:NodifyEditor.ItemTemplate>

                <!-- ===== 连接样式 ===== -->
                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                        <nodify:Connection Source="{Binding Output.Anchor, Mode=OneWay}"
                                          Target="{Binding Input.Anchor, Mode=OneWay}"
                                          Stroke="{DynamicResource FlowNode.ConnectorStroke}"
                                          StrokeThickness="2" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>

                <!-- ===== 拖拽中连线样式 ===== -->
                <nodify:NodifyEditor.PendingConnectionTemplate>
                    <DataTemplate>
                        <nodify:PendingConnection Stroke="{DynamicResource FlowNode.ConnectionPreview}"
                                                  StrokeThickness="2"
                                                  StrokeDashArray="4,2" />
                    </DataTemplate>
                </nodify:NodifyEditor.PendingConnectionTemplate>

            </nodify:NodifyEditor>
        </Grid>

        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

        <!-- 右侧：属性面板 -->
        <local:NodePropertiesView x:Name="Properties" Grid.Column="4" />
    </Grid>
</UserControl>
