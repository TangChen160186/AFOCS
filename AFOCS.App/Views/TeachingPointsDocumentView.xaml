<UserControl x:Class="AFOCS.App.Views.TeachingPointsDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:vm="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="780"
             d:DataContext="{d:DesignInstance vm:TeachingPointsDocumentViewModel}"
             Background="{DynamicResource EnvironmentWindowBackground}"
             IsTabStop="False">

    <UserControl.Resources>
        <!-- 颜色定义 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FFDBEAFE" />
        <SolidColorBrush x:Key="CardBg" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="CardBorder" Color="#FFE2E8F0" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FF1E293B" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF64748B" />
        <SolidColorBrush x:Key="TextMuted" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFEF4444" />
        <SolidColorBrush x:Key="DangerLightBrush" Color="#FFFEE2E2" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF059669" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#FFF1F5F9" />

        <!-- 示教点列表项样式 -->
        <Style x:Key="TeachingPointListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Margin="1,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Dot" Grid.Column="0"
                                         Width="8" Height="8"
                                         Fill="{StaticResource TextMuted}"
                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFDBEAFE" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮样式：主按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FFCBD5E1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮样式：次要按钮 -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBorder}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFCBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮样式：危险按钮 -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerLightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFECACA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource CardBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片样式 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 区段标题样式 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12,10">

        <!-- ========== 底部状态栏 ========== -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0"
                Padding="10,7" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                        <Setter Property="Fill" Value="#FFF59E0B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" />
                    <ProgressBar Width="80" Height="5" IsIndeterminate="True" Margin="10,0,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <TextBlock Text="● 已修改" FontSize="10"
                               Foreground="#FFF59E0B" VerticalAlignment="Center"
                               Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModified}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button cal:Message.Attach="SaveAsync" Content="保存"
                            Width="72" Height="28"
                            Padding="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModified}" Value="False">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 主内容 ========== -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- 轴选择区 -->
                <RowDefinition Height="Auto" />
                <!-- 示教点编辑区 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ========== 轴选择卡片 ========== -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="轴选择" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="勾选示教点需要包含的轴，应用于所有示教点"
                               FontSize="11" Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,8" />

                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding AvailableAxes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Content="{Binding DisplayName}"
                                              Margin="0,0,14,5"
                                              FontSize="11"
                                              Foreground="{StaticResource TextSecondary}"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <Button cal:Message.Attach="ApplyAxisSelection"
                            Content="应用轴选择"
                            Style="{StaticResource SecondaryButton}"
                            Width="88" Height="26" Margin="0,6,0,0" Padding="0" />
                </StackPanel>
            </Border>

            <!-- ========== 示教点编辑卡片 ========== -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 左侧列表 -->
                        <ColumnDefinition Width="200" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <!-- 右侧编辑 -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：示教点列表 -->
                    <Border Grid.Column="0"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="0,0,1,0"
                            Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 列表标题 -->
                            <Border Grid.Row="0" Padding="14,10"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="0,0,0,1">
                                <TextBlock Text="示教点列表"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                            </Border>

                            <!-- 示教点列表 -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding TeachingPoints}"
                                     SelectedItem="{Binding SelectedTeachingPoint, Mode=TwoWay}"
                                     DisplayMemberPath="Name"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource TeachingPointListBoxItem}"
                                     Padding="4,3"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TeachingPoints.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                            </ListBox>

                            <!-- 空状态提示 -->
                            <TextBlock Grid.Row="1" Text="暂无示教点&#x0a;点击添加创建"
                                       FontSize="12" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" LineHeight="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TeachingPoints.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 按钮 -->
                            <Border Grid.Row="2" Padding="8,7"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button cal:Message.Attach="AddTeachingPoint"
                                            Content="+ 添加"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="54" Height="24" Padding="0"
                                            Margin="0,0,5,0" />
                                    <Button cal:Message.Attach="DeleteTeachingPoint"
                                            Content="− 删除"
                                            Style="{StaticResource DangerButton}"
                                            Width="54" Height="24" Padding="0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 分隔线 -->
                    <GridSplitter Grid.Column="1" Width="4"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="True" />

                    <!-- 右侧：坐标编辑 -->
                    <Border Grid.Column="2" Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 标题 -->
                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource GridLineBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,6" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="示教点坐标"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text=" — "
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding SelectedTeachingPoint.Name}"
                                               FontSize="12" Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTeachingPoint}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 空状态 -->
                            <TextBlock Grid.Row="1"
                                       Text="请在左侧选择或创建一个示教点"
                                       FontSize="12" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTeachingPoint}"
                                                         Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentPositions.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 坐标表格 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CurrentPositions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4"
                                                    BorderBrush="{StaticResource GridLineBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 轴名称 -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="11.5"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               Margin="0,0,8,0" />

                                                    <!-- 单位 -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="unit"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextMuted}"
                                                               Margin="0,0,6,0" />

                                                    <!-- 位置输入 -->
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding Position, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F4}}"
                                                             FontSize="12"
                                                             FontWeight="SemiBold"
                                                             Foreground="{StaticResource TextPrimary}"
                                                             VerticalContentAlignment="Center"
                                                             HorizontalContentAlignment="Right"
                                                             Width="88" Height="24"
                                                             BorderBrush="{StaticResource CardBorder}"
                                                             Background="White" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
