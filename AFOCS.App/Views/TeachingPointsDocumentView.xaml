<UserControl x:Class="AFOCS.App.Views.TeachingPointsDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:vm="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:TeachingPointsDocumentViewModel}"
             Background="#F3F3F3"
             IsTabStop="False">

    <UserControl.Resources>
        <!-- ===== 亮色主题颜色 ===== -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#EBF3FB" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A" />
        <SolidColorBrush x:Key="TextSecondary" Color="#888888" />
        <SolidColorBrush x:Key="TextMuted" Color="#B0B0B0" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="DangerLightBrush" Color="#FEE2E2" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ===== 按钮样式 ===== -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1558B3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 示教点列表项 ===== -->
        <Style x:Key="PointListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="10">

        <!-- ========== 底部状态栏 ========== -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8" Padding="10,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <!-- 状态指示灯 -->
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <ProgressBar Width="80" Height="5" IsIndeterminate="True" Margin="10,0,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock FontSize="10" Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="● 已修改"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModified}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button cal:Message.Attach="SaveAsync" Content="保存"
                            Width="72" Height="28" Padding="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModified}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 主内容 ========== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 工位选择 ===== -->
            <Border Grid.Row="0" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="8" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button cal:Message.Attach="SelectStation('左工位')"
                            Width="96" Height="32" FontSize="14" FontWeight="SemiBold"
                            Cursor="Hand" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource CardBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EBEBEB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedStation}" Value="左工位">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="左工位"/>
                    </Button>
                    <Button cal:Message.Attach="SelectStation('右工位')"
                            Width="96" Height="32" FontSize="14" FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource CardBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EBEBEB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedStation}" Value="右工位">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="右工位"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===== 轴选择 ===== -->
            <Border Grid.Row="1" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="轴选择" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="勾选当前工位需要包含的轴，自由命名示教点后可添加"
                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                    <ItemsControl ItemsSource="{Binding StationAxisGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding GroupName}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                               Margin="0,4,0,2"/>
                                    <WrapPanel>
                                        <ItemsControl ItemsSource="{Binding Axes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              Content="{Binding DisplayName}"
                                                              Margin="0,0,14,4" FontSize="11"
                                                              Foreground="{StaticResource TextSecondary}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button cal:Message.Attach="AddTeachingPoint"
                                Content="+ 添加示教点" Style="{StaticResource PrimaryButton}"
                                Width="98" Height="28" Padding="0"/>
                        <Button cal:Message.Attach="ReadCurrentPosition"
                                Content="读取坐标" Style="{StaticResource SecondaryButton}"
                                Width="72" Height="28" Padding="0" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 示教点编辑区（两列） ===== -->
            <Border Grid.Row="2" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" MinWidth="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- === 左侧：示教点列表 === -->
                    <Border Grid.Column="0"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 列表标题 -->
                            <Border Grid.Row="0" Padding="14,10"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedStation}" FontSize="12"
                                               FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text=" 示教点" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </Border>

                            <!-- 列表 -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding StationPoints}"
                                     SelectedItem="{Binding SelectedTeachingPoint, Mode=TwoWay}"
                                     DisplayMemberPath="Name"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource PointListBoxItem}"
                                     Padding="4,3"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                            <!-- 底部操作 -->
                            <Border Grid.Row="2" Padding="8,7"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
                                <Button cal:Message.Attach="DeleteTeachingPoint"
                                        Content="删除选中" Style="{StaticResource DangerButton}"
                                        Width="72" Height="24" Padding="0">
                                   
                                </Button>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 分隔 -->
                    <GridSplitter Grid.Column="1" Width="4"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="Transparent" ShowsPreview="True"/>

                    <!-- === 右侧：点编辑 === -->
                    <Border Grid.Column="2" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 点名称编辑 -->
                            <Border Grid.Row="0" Padding="0,0,0,10"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="名称:" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding PointName, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13" FontWeight="SemiBold"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="White" BorderBrush="#D0D0D0"
                                             VerticalContentAlignment="Center" Padding="6,3"
                                             IsEnabled="{Binding IsPointSelected}"/>
                                </Grid>
                            </Border>

                            <!-- 选择的轴（只读显示） -->
                            <Border Grid.Row="1" Padding="0,8,0,6">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                                    <Run Text="当前编辑: "/>
                                    <Run Text="{Binding SelectedTeachingPoint.Name, TargetNullValue='—'}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </Border>

                            <!-- 坐标表格 -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CurrentPositions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,3"
                                                    BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}" FontSize="11.5"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondary}"/>

                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Position, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F4}}"
                                                             FontSize="12"
                                                             Foreground="{StaticResource TextPrimary}"
                                                             VerticalContentAlignment="Center"
                                                             HorizontalContentAlignment="Right"
                                                             Width="100" Height="26"
                                                             HorizontalAlignment="Right"
                                                             BorderBrush="#E5E5E5"
                                                             Background="{StaticResource CardBg}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
