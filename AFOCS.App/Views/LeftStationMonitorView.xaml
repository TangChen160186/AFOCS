<UserControl x:Class="AFOCS.App.Views.LeftStationMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 表头 -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="通道" FontWeight="Bold" Foreground="#888" />
            <TextBlock Grid.Column="1" Text="RSP" FontWeight="Bold" Foreground="#888" />
            <TextBlock Grid.Column="2" Text="MPD_IN" FontWeight="Bold" Foreground="#888" />
            <TextBlock Grid.Column="3" Text="MPD_OUT" FontWeight="Bold" Foreground="#888" />
        </Grid>

        <!-- 值竖排（支持滚动） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Channels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Channel}" Foreground="#999" />
                                <TextBlock Grid.Column="1" Text="{Binding Rsp, StringFormat={}{0:F3}}" />
                                <TextBlock Grid.Column="2" Text="{Binding MpdIn, StringFormat={}{0:F0}}" />
                                <TextBlock Grid.Column="3" Text="{Binding MpdOut, StringFormat={}{0:F0}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
