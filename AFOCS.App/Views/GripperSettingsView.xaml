<UserControl x:Class="AFOCS.App.Views.GripperSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:viewModels="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="460"
             d:DataContext="{d:DesignInstance viewModels:GripperSettingsViewModel}"
             IsTabStop="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SectionBg" Color="#FFF3F4F6" />
        <SolidColorBrush x:Key="LabelFg" Color="#FF6B7280" />
        <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="AlarmBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="NormalBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DisabledBrush" Color="#9CA3AF" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,5">
            <!-- ========== 从站地址 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="从站地址" FontWeight="Bold" Margin="0,0,0,6" />
                    <DockPanel>
                        <TextBlock Text="Slave Address" VerticalAlignment="Center" Width="90"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding SlaveAddress, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                 VerticalContentAlignment="Center" Height="24" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <!-- ========== 名称 & 状态 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ConnectedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource LabelFg}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button cal:Message.Attach="SaveAsync"
                    Content="保存配置" Width="100" Padding="8,5"
                    HorizontalAlignment="Left" Margin="0,0,0,8" />

            <!-- ========== 实时状态 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="实时状态" FontWeight="Bold" Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 当前位置 -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="当前位置" Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                                <Run Text="{Binding CurrentPosition}" /><Run Text=" " FontSize="11" Foreground="{StaticResource LabelFg}" /><Run Text="(0.01mm)" FontSize="10" Foreground="{StaticResource LabelFg}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- 使能状态 -->
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="使能" Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DisabledBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource ConnectedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="未使能" />
                                            <Setter Property="Foreground" Value="{StaticResource LabelFg}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Text" Value="已使能" />
                                                    <Setter Property="Foreground" Value="{StaticResource ConnectedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- 报警状态 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="报警" Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource NormalBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AlarmBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="正常" />
                                            <Setter Property="Foreground" Value="{StaticResource NormalBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                    <Setter Property="Text" Value="报警中" />
                                                    <Setter Property="Foreground" Value="{StaticResource AlarmBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 状态字 -->
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="状态字: " Foreground="{StaticResource LabelFg}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBlock FontSize="11" FontFamily="Consolas" VerticalAlignment="Center">
                            <Run Text="0x" /><Run Text="{Binding StatusWord, StringFormat=X4}" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ========== 操作控制 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="操作控制" FontWeight="Bold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button cal:Message.Attach="EnableAsync" Content="使能" Width="70" Padding="6,3" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button cal:Message.Attach="HomeAsync" Content="回零" Width="70" Padding="6,3" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button cal:Message.Attach="AlarmResetAsync" Content="报警复位" Width="80" Padding="6,3">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========== 功能测试 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="功能测试" FontWeight="Bold" Margin="0,0,0,6" />

                    <!-- 速度设置 -->
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="速度" VerticalAlignment="Center" Width="50"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding TestSpeed, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                 VerticalContentAlignment="Center" Height="24" />
                    </DockPanel>

                    <!-- 打开/关闭目标位置 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="关闭位" VerticalAlignment="Center" Width="50"
                                       Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <TextBox Text="{Binding ClosePosition, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                     VerticalContentAlignment="Center" Height="24" />
                        </DockPanel>
                        <DockPanel Grid.Column="1">
                            <TextBlock Text="打开位" VerticalAlignment="Center" Width="50"
                                       Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <TextBox Text="{Binding OpenPosition, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                     VerticalContentAlignment="Center" Height="24" />
                        </DockPanel>
                    </Grid>

                    <!-- 开/关按钮 -->
                    <StackPanel Orientation="Horizontal">
                        <Button cal:Message.Attach="CloseAsync" Content="关闭" Width="80" Padding="6,4" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#DC2626" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#DC2626" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button cal:Message.Attach="OpenAsync" Content="打开" Width="80" Padding="6,4">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#10B981" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#10B981" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        

        </StackPanel>
    </ScrollViewer>
</UserControl>
