<UserControl x:Class="AFOCS.App.Views.JogRightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:vm="clr-namespace:AFOCS.App.ViewModels"
    xmlns:settings="clr-namespace:AFOCS.App.ViewModels.Settings"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:JogRightViewModel}"
    d:DesignHeight="560" d:DesignWidth="580">

    <UserControl.Resources>
        <SolidColorBrush x:Key="MovingBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="IdleBrush" Color="#999999" />
        <settings:BoolToBrushConverter x:Key="BoolToMovingBrush" OnBrush="{StaticResource MovingBrush}" OffBrush="{StaticResource IdleBrush}" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>

        <ControlTemplate x:Key="PadBtnTpl" TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="6"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" Opacity="0.15" BlurRadius="2" />
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.65" />
                    <Setter TargetName="bd" Property="Effect">
                        <Setter.Value><DropShadowEffect ShadowDepth="0" Opacity="0" /></Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DirBtn" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource PadBtnTpl}" />
        </Style>

        <Style x:Key="LeftBtn" TargetType="Button" BasedOn="{StaticResource DirBtn}">
            <Setter Property="Background" Value="#AB47BC" />
            <Setter Property="BorderBrush" Value="#7B1FA2" />
        </Style>
        <Style x:Key="RightBtn" TargetType="Button" BasedOn="{StaticResource DirBtn}">
            <Setter Property="Background" Value="#26A69A" />
            <Setter Property="BorderBrush" Value="#00695C" />
        </Style>

        <Style x:Key="StopBtn" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#E53935" />
            <Setter Property="BorderBrush" Value="#B71C1C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource PadBtnTpl}" />
        </Style>
        <Style x:Key="HomeBtn" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#00897B" />
            <Setter Property="BorderBrush" Value="#004D40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource PadBtnTpl}" />
        </Style>

        <DataTemplate x:Key="CardH" DataType="{x:Type vm:JogAxisItem}">
            <Border Background="White" CornerRadius="6" Padding="6,3"
                    BorderBrush="#DDD" BorderThickness="1" Margin="2">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" Opacity="0.06" BlurRadius="2" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="10"
                               Foreground="#777" HorizontalAlignment="Center"
                               Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="◀" Style="{StaticResource LeftBtn}"
                                Command="{Binding JogNegativeCommand}" ToolTip="反向" />
                        <TextBlock Text="{Binding Position, StringFormat='{}{0:F3}'}"
                                   Width="56" TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding IsMoving, Converter={StaticResource BoolToMovingBrush}}"
                                   Margin="1,0" />
                        <Button Content="▶" Style="{StaticResource RightBtn}"
                                Command="{Binding JogPositiveCommand}" ToolTip="正向" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Button Content="■" Style="{StaticResource StopBtn}"
                                Command="{Binding StopCommand}" ToolTip="停止" Margin="0,0,2,0" />
                        <Button Content="0" Style="{StaticResource HomeBtn}"
                                Command="{Binding HomeCommand}" ToolTip="回零" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Background="#F0F0F0">
        <Border DockPanel.Dock="Top" Background="#E0E0E0" Padding="8,4"
                BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="步长:" VerticalAlignment="Center" Foreground="#555" FontSize="11" />
                <TextBox Text="{Binding JogDistance, UpdateSourceTrigger=PropertyChanged}"
                         Width="45" Height="20" Margin="2,0,8,0"
                         Background="White" BorderBrush="#BBB" BorderThickness="1"
                         VerticalContentAlignment="Center" FontSize="11" />
                <TextBlock Text="mm" VerticalAlignment="Center" Foreground="#999" FontSize="10" Margin="0,0,12,0" />
                <TextBlock Text="速度:" VerticalAlignment="Center" Foreground="#555" FontSize="11" />
                <TextBox Text="{Binding JogSpeed, UpdateSourceTrigger=PropertyChanged}"
                         Width="55" Height="20" Margin="2,0,6,0"
                         Background="White" BorderBrush="#BBB" BorderThickness="1"
                         VerticalContentAlignment="Center" FontSize="11" />
                <TextBlock Text="mm/s" VerticalAlignment="Center" Foreground="#999" FontSize="10" />
            </StackPanel>
        </Border>

        <Border x:Name="ErrorBar" DockPanel.Dock="Top"
                Background="#FFF3CD" BorderBrush="#FFCA2C" BorderThickness="0,0,0,1"
                Padding="6,3" Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LastError}" Foreground="#664D03"
                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="✕" Width="20" Height="20"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#664D03" FontSize="12" Cursor="Hand"
                        cal:Message.Attach="DismissError" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="6,2">
                <TextBlock Text="◆ 上视相机" Style="{StaticResource SectionHeader}" />
                <Border Background="#FAFAFA" CornerRadius="6" Padding="4"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding CameraAxes}" ItemTemplate="{StaticResource CardH}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <TextBlock Text="◆ 耦合θ轴" Style="{StaticResource SectionHeader}" />
                <Border Background="#FAFAFA" CornerRadius="6" Padding="4"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding ThetaAxes}" ItemTemplate="{StaticResource CardH}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <TextBlock Text="◆ 直线轴（暂未实现）" Style="{StaticResource SectionHeader}" Foreground="#999" />
                <Border Background="#FAFAFA" CornerRadius="6" Padding="4"
                        BorderBrush="#E0E0E0" BorderThickness="1" Opacity="0.45"
                        IsHitTestVisible="False">
                    <ItemsControl ItemsSource="{Binding LinearAxes}" ItemTemplate="{StaticResource CardH}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <TextBlock Text="◆ 夹爪（暂未实现）" Style="{StaticResource SectionHeader}" Foreground="#999" />
                <Border Background="#FAFAFA" CornerRadius="6" Padding="4"
                        BorderBrush="#E0E0E0" BorderThickness="1" Opacity="0.45"
                        IsHitTestVisible="False">
                    <ItemsControl ItemsSource="{Binding Grippers}" ItemTemplate="{StaticResource CardH}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
