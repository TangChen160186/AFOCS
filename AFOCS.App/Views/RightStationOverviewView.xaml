<Window x:Class="AFOCS.App.Views.RightStationOverviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="http://www.caliburnproject.org"
        Title="右工位总览"
        Width="100" Height="800" MinWidth="1000" MinHeight="800"
        Background="{DynamicResource EnvironmentWindowBackground}">
    <Window.Resources>
        <!-- 现代化扁平卡片：圆角 + 细边框 + 顶部标题 -->
        <Style x:Key="FlatCard" TargetType="GroupBox">
            <Setter Property="Background" Value="{DynamicResource MenuPopupDefaultBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MenuPopupDefaultBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top"
                                                  ContentSource="Header"
                                                  Margin="10,7,10,5"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{DynamicResource EnvironmentWindowText}" />
                                <ContentPresenter Margin="6,0,6,6" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化扁平按钮：细边框 + 圆角 + 悬浮反馈 -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource MenuPopupDefaultBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MenuPopupDefaultBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                            <!-- 禁用态：明显区别于可用态（深灰底 + 灰字 + 半透明） -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D2D" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A3A" />
                             
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 第1行：流程节点监视（左）/ 生产信息（右） -->
        <GroupBox Grid.Row="0" Grid.Column="0" Margin="4" Style="{StaticResource FlatCard}">
            <GroupBox.Header>
                <!-- 流程状态显示在标题旁，同一行 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="流程监视" />
                    <TextBlock Text="{Binding FlowMonitor.FlowStatusText}" FontWeight="Bold"
                               Foreground="{Binding FlowMonitor.FlowStatusBrush}" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="200" />
                </StackPanel>
            </GroupBox.Header>
            <ContentControl cal:View.Model="{Binding FlowMonitor}" />
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.Column="2" Margin="4" Style="{StaticResource FlatCard}" Header="生产信息">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 第一行：良品 / 不良个数 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="良品" Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding GoodCount}" FontSize="26" FontWeight="Bold" Foreground="#2E9E5B" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="不良" Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BadCount}" FontSize="26" FontWeight="Bold" Foreground="#D9534F" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 第二行：SN / 胶水 SN -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="SN" Foreground="#888" FontSize="10" />
                        <TextBlock Text="{Binding Ipsn}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="胶水SN" Foreground="#888" FontSize="10" />
                        <TextBlock Text="{Binding GlueSn}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- 第三行：启动 / 回零 / 安全位 -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="启动" Margin="0,0,4,0"
                            Style="{StaticResource FlatButton}" cal:Message.Attach="Start" />
                    <Button Grid.Column="1" Content="回零" Margin="2,0,2,0"
                            Style="{StaticResource FlatButton}" cal:Message.Attach="Home" />
                    <Button Grid.Column="2" Content="安全位" Margin="4,0,0,0"
                            Style="{StaticResource FlatButton}" cal:Message.Attach="SafePosition" />
                </Grid>

                <!-- 第四行：急停 / 取消 -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="急停" Margin="0,0,4,0" FontWeight="Bold"
                            Style="{StaticResource FlatButton}" Background="#D9534F" Foreground="White"
                            cal:Message.Attach="EmergencyStop" />
                    <Button Grid.Column="1" Content="取消" Margin="4,0,0,0"
                            Style="{StaticResource FlatButton}" cal:Message.Attach="Cancel" />
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 第2行：相机左右排列（左）/ RSP、MPD 监控（右） -->
        <GroupBox Grid.Row="2" Grid.Column="0" Margin="4" Style="{StaticResource FlatCard}" Header="相机">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" cal:View.Model="{Binding UpCamera}" />
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{DynamicResource MenuPopupDefaultBorder}" />
                <ContentControl Grid.Column="2" cal:View.Model="{Binding DownCamera}" />
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="2" Margin="4" Style="{StaticResource FlatCard}" Header="RSP / MPD">
            <ContentControl cal:View.Model="{Binding StationMonitor}" />
        </GroupBox>

        <!-- 第3行：RX 曲线（左）/ TX 曲线（右） -->
        <GroupBox Grid.Row="4" Grid.Column="0" Margin="4" Style="{StaticResource FlatCard}" Header="RX 曲线">
            <ContentControl cal:View.Model="{Binding RxCurve}" />
        </GroupBox>
        <GroupBox Grid.Row="4" Grid.Column="2" Margin="4" Style="{StaticResource FlatCard}" Header="TX 曲线">
            <ContentControl cal:View.Model="{Binding TxCurve}" />
        </GroupBox>

        <!-- 列分隔条：拖动调整左右列宽 -->
        <GridSplitter Grid.Row="0" Grid.RowSpan="5" Grid.Column="1"
                      Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{DynamicResource MenuPopupDefaultBorder}" />

        <!-- 行分隔条：拖动调整行高 -->
        <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                      Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource MenuPopupDefaultBorder}" />
        <GridSplitter Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                      Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource MenuPopupDefaultBorder}" />
    </Grid>
</Window>