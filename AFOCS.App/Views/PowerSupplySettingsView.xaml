<UserControl x:Class="AFOCS.App.Views.PowerSupplySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:viewModels="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="460"
             d:DataContext="{d:DesignInstance viewModels:PowerSupplySettingsViewModel}"
             IsTabStop="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#EF4444" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,5">
            <!-- ========== 连接状态 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ConnectedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="连接状态:" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                   FontWeight="Bold" Margin="4,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button cal:Message.Attach="DisconnectAsync"
                                Width="60" Padding="6,3" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            断开
                        </Button>
                        <Button cal:Message.Attach="ReconnectAsync"
                                Width="60" Padding="6,3">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            重连
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 配置 ========== -->
            <TextBlock Text="连接配置" FontWeight="Bold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <Label Width="90" Content="VISA 地址:" VerticalAlignment="Center" />
                <TextBox Width="280" Text="{Binding VisaAddress, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Label Width="90" VerticalAlignment="Center" />
                <Button Content="扫描可用资源" cal:Message.Attach="ScanAvailableResources"
                        Width="110" Padding="6,3">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ProgressBar Width="120" Height="14" Margin="8,0,0,0" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>

            <ComboBox ItemsSource="{Binding AvailableResources}"
                      Text="{Binding VisaAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      Margin="90,4,0,0" Width="280"
                      HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Width="90" Content="超时时间(ms):" VerticalAlignment="Center" />
                <TextBox Width="100" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- ========== 通道测试 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="通道测试" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="读取全部" cal:Message.Attach="ReadAllChannelsAsync"
                                Width="70" Padding="6,3">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Channels}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 通道标签 -->
                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                Background="#E5E7EB" CornerRadius="3"
                                                VerticalAlignment="Stretch" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Number, StringFormat='CH{0}'}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold" FontSize="12" />
                                        </Border>

                                        <!-- 第 1 行: 设置值 -->
                                        <StackPanel Grid.Row="0" Grid.Column="1"
                                                    Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="设置:" VerticalAlignment="Center"
                                                       FontSize="11" Margin="0,0,6,0" />
                                            <TextBox Width="60" Margin="0,0,4,0" FontSize="11"
                                                     Text="{Binding TargetVoltage, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="V" VerticalAlignment="Center"
                                                       FontSize="11" Margin="0,0,8,0" />
                                            <TextBox Width="60" Margin="0,0,4,0" FontSize="11"
                                                     Text="{Binding TargetCurrent, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="A" VerticalAlignment="Center" FontSize="11" />
                                        </StackPanel>

                                        <!-- 第 2 行: 实测值 + 操作 -->
                                        <Grid Grid.Row="1" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="实测:" VerticalAlignment="Center"
                                                           FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{StaticResource ConnectedBrush}">
                                                    <Run Text="{Binding ActualVoltage, StringFormat={}{0:F2}}" />
                                                    <Run Text=" V / " />
                                                    <Run Text="{Binding ActualCurrent, StringFormat={}{0:F2}}" />
                                                    <Run Text=" A" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <!-- 忙状态指示 -->
                                                <ProgressBar Width="40" Height="10" IsIndeterminate="True"
                                                             Margin="0,0,4,0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>

                                                <ToggleButton Width="36" Height="22" FontSize="10"
                                                              cal:Message.Attach="ToggleChannelAsync($dataContext)">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="IsChecked" Value="False" />
                                                            <Setter Property="Content" Value="OFF" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="IsChecked" Value="True" />
                                                                    <Setter Property="Content" Value="ON" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>

                                                <Button Content="读取" Width="44" Height="22"
                                                        FontSize="10" Margin="4,0,4,0"
                                                        cal:Message.Attach="ReadChannelAsync($dataContext)">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Content="应用" Width="44" Height="22"
                                                        FontSize="10"
                                                        cal:Message.Attach="ApplyChannelAsync($dataContext)">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 底部进度条 -->
            <ProgressBar Height="6" IsIndeterminate="True" Margin="0,8,0,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource EnvironmentWindowText}"
                       Opacity="0.7" FontSize="12">
                修改后点击 OK 保存连接配置。VISA 地址格式示例：<LineBreak />
                TCPIP0::192.168.1.100::inst0::INSTR
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
