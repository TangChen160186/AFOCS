<UserControl x:Class="AFOCS.App.Views.GamepadControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:vm="clr-namespace:AFOCS.App.ViewModels"
             xmlns:infrastructure="clr-namespace:AFOCS.Infrastructure;assembly=AFOCS.Infrastructure"
             xmlns:converter="clr-namespace:AFOCS.App.Converter"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GamepadControlViewModel}"
             Background="#F3F3F3">

    <UserControl.Resources>
        <!-- ===== 颜色 ===== -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#EBF3FB" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A" />
        <SolidColorBrush x:Key="TextSecondary" Color="#888888" />
        <SolidColorBrush x:Key="TextMuted" Color="#B0B0B0" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converter:EnumToCollectionConverter x:Key="EnumToCollection"/>

        <!-- ===== D-Pad 方向按钮 ===== -->
        <Style x:Key="DPadBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 次要按钮（刷新用） ===== -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>

            <!-- ===== 状态 ===== -->
            <Border Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="80" Height="5" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ===== 压力监控 ===== -->
            <Border Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="压力监控" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>

                    <!-- 左耦合 -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="左耦合" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding PressureLText}" FontSize="15" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding HasPressureL, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- 右耦合 -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="右耦合" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding PressureRText}" FontSize="15" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding HasPressureR, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- 点胶 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="点胶" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding PressureDispenseText}" FontSize="15" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding HasPressureDispense, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 工位选择 ===== -->
            <Border Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="8" Margin="0,0,0,6">

                <ListBox ItemsSource="{Binding Converter={StaticResource EnumToCollection},
                              ConverterParameter={x:Type infrastructure:WorkPos}}"
                         DisplayMemberPath="Description"
                         SelectedValuePath="Value"
                         SelectedValue="{Binding SelectedStation}"
                         HorizontalAlignment="Center"
                         BorderThickness="0" Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="72"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="Background" Value="{StaticResource CardBorder}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EBEBEB"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
            </Border>

            <!-- ===== 步长 ===== -->
            <Border Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="相机:" FontSize="11" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding CameraJogStep, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Height="24" FontSize="11"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                             Margin="0,0,12,0" BorderBrush="#D0D0D0"/>
                    <TextBlock Text="旋转:" FontSize="11" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding RotationJogStep, UpdateSourceTrigger=PropertyChanged}"
                             Width="42" Height="24" FontSize="11"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                             Margin="0,0,12,0" BorderBrush="#D0D0D0"/>
                    <TextBlock Text="Ak:" FontSize="11" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding AkribisJogStep, UpdateSourceTrigger=PropertyChanged}"
                             Width="100" Height="24" FontSize="11"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                             Margin="0,0,12,0" BorderBrush="#D0D0D0"/>
                    <TextBlock Text="夹爪:" FontSize="11" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding GripperStep, UpdateSourceTrigger=PropertyChanged}"
                             Width="40" Height="24" FontSize="11"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                             BorderBrush="#D0D0D0"/>
                </StackPanel>
            </Border>

            <!-- ===== D-Pad 两列布局 ===== -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 左列 ===== -->
                <StackPanel Grid.Column="0">

                    <!-- 1. 相机 D-Pad -->
                    <Border Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="相机轴（总线）" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>

                            <Grid HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左：当前位置（竖排） -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0"
                                            Visibility="{Binding HasCameraPos, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CameraPosXText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding CameraPosYText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding CameraPosZText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding CameraSidePosText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>

                                <!-- 中：十字（XY） -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="1" cal:Message.Attach="JogBusCamera('Y', 1)"
                                            Content="▲" Style="{StaticResource DPadBtn}" Background="#3498DB"/>
                                    <Button Grid.Row="1" Grid.Column="0" cal:Message.Attach="JogBusCamera('X', -1)"
                                            Content="◀" Style="{StaticResource DPadBtn}" Background="#E74C3C"/>
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Content="●" Style="{StaticResource DPadBtn}" Background="#BDC3C7" IsEnabled="False"/>
                                    <Button Grid.Row="1" Grid.Column="2" cal:Message.Attach="JogBusCamera('X', 1)"
                                            Content="▶" Style="{StaticResource DPadBtn}" Background="#27AE60"/>
                                    <Button Grid.Row="2" Grid.Column="1" cal:Message.Attach="JogBusCamera('Y', -1)"
                                            Content="▼" Style="{StaticResource DPadBtn}" Background="#E67E22"/>
                                </Grid>

                                <!-- 右：Z 竖排 + 侧相机（竖排，位于 Z 右侧） -->
                                <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Z 列 -->
                                    <StackPanel Grid.Column="0">
                                        <Button cal:Message.Attach="JogBusCamera('Z', 1)" Content="Z+"
                                                Style="{StaticResource DPadBtn}" Background="#2ECC71" Margin="0,0,4,4"/>
                                        <Button cal:Message.Attach="JogBusCamera('Z', -1)" Content="Z−"
                                                Style="{StaticResource DPadBtn}" Background="#95A5A6" Margin="0,0,4,0"/>
                                    </StackPanel>

                                    <!-- 侧相机列（Y 方向，竖排） -->
                                    <StackPanel Grid.Column="1">
                                        <Button cal:Message.Attach="JogBusCameraSide(-1)" Content="◀"
                                                Style="{StaticResource DPadBtn}" Background="#E74C3C" Margin="0,0,0,4"/>
                                        <Button cal:Message.Attach="JogBusCameraSide(1)" Content="▶"
                                                Style="{StaticResource DPadBtn}" Background="#27AE60"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. 左旋转 D-Pad -->
                    <Border Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="左耦合旋转轴（总线）" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>

                            <Grid HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左：当前位置（竖排） -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0"
                                            Visibility="{Binding HasLeftRotPos, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding LeftRotPosXText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding LeftRotPosYText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding LeftRotPosZText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>

                                <!-- 中：十字（XY） -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="1" cal:Message.Attach="JogBusLeftRot('Y', 1)"
                                            Content="▲" Style="{StaticResource DPadBtn}" Background="#3498DB"/>
                                    <Button Grid.Row="1" Grid.Column="0" cal:Message.Attach="JogBusLeftRot('X', -1)"
                                            Content="◀" Style="{StaticResource DPadBtn}" Background="#E74C3C"/>
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Content="●" Style="{StaticResource DPadBtn}" Background="#BDC3C7" IsEnabled="False"/>
                                    <Button Grid.Row="1" Grid.Column="2" cal:Message.Attach="JogBusLeftRot('X', 1)"
                                            Content="▶" Style="{StaticResource DPadBtn}" Background="#27AE60"/>
                                    <Button Grid.Row="2" Grid.Column="1" cal:Message.Attach="JogBusLeftRot('Y', -1)"
                                            Content="▼" Style="{StaticResource DPadBtn}" Background="#E67E22"/>
                                </Grid>

                                <!-- 右：Z 竖排 -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Button cal:Message.Attach="JogBusLeftRot('Z', 1)" Content="Z+"
                                            Style="{StaticResource DPadBtn}" Background="#2ECC71"/>
                                    <Button cal:Message.Attach="JogBusLeftRot('Z', -1)" Content="Z−"
                                            Style="{StaticResource DPadBtn}" Background="#95A5A6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. 右旋转 D-Pad -->
                    <Border Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="右耦合旋转轴（总线）" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>

                            <Grid HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左：当前位置（竖排） -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0"
                                            Visibility="{Binding HasRightRotPos, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding RightRotPosXText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding RightRotPosYText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding RightRotPosZText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>

                                <!-- 中：十字（XY） -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="1" cal:Message.Attach="JogBusRightRot('Y', 1)"
                                            Content="▲" Style="{StaticResource DPadBtn}" Background="#3498DB"/>
                                    <Button Grid.Row="1" Grid.Column="0" cal:Message.Attach="JogBusRightRot('X', -1)"
                                            Content="◀" Style="{StaticResource DPadBtn}" Background="#E74C3C"/>
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Content="●" Style="{StaticResource DPadBtn}" Background="#BDC3C7" IsEnabled="False"/>
                                    <Button Grid.Row="1" Grid.Column="2" cal:Message.Attach="JogBusRightRot('X', 1)"
                                            Content="▶" Style="{StaticResource DPadBtn}" Background="#27AE60"/>
                                    <Button Grid.Row="2" Grid.Column="1" cal:Message.Attach="JogBusRightRot('Y', -1)"
                                            Content="▼" Style="{StaticResource DPadBtn}" Background="#E67E22"/>
                                </Grid>

                                <!-- 右：Z 竖排 -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Button cal:Message.Attach="JogBusRightRot('Z', 1)" Content="Z+"
                                            Style="{StaticResource DPadBtn}" Background="#2ECC71"/>
                                    <Button cal:Message.Attach="JogBusRightRot('Z', -1)" Content="Z−"
                                            Style="{StaticResource DPadBtn}" Background="#95A5A6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ===== 右列 ===== -->
                <StackPanel Grid.Column="2">

                    <!-- 4. 雅克贝斯 L D-Pad -->
                    <Border Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding AkribisLDisplay}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>

                            <Grid HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左：当前位置（竖排） -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0"
                                            Visibility="{Binding HasAkribisLPos, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding AkribisLPosXText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding AkribisLPosYText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding AkribisLPosZText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>

                                <!-- 中：十字（XY） -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="1" cal:Message.Attach="JogAkribisL('Y', 1)"
                                            Content="▲" Style="{StaticResource DPadBtn}" Background="#3498DB"/>
                                    <Button Grid.Row="1" Grid.Column="0" cal:Message.Attach="JogAkribisL('X', -1)"
                                            Content="◀" Style="{StaticResource DPadBtn}" Background="#E74C3C"/>
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Content="●" Style="{StaticResource DPadBtn}" Background="#BDC3C7" IsEnabled="False"/>
                                    <Button Grid.Row="1" Grid.Column="2" cal:Message.Attach="JogAkribisL('X', 1)"
                                            Content="▶" Style="{StaticResource DPadBtn}" Background="#27AE60"/>
                                    <Button Grid.Row="2" Grid.Column="1" cal:Message.Attach="JogAkribisL('Y', -1)"
                                            Content="▼" Style="{StaticResource DPadBtn}" Background="#E67E22"/>
                                </Grid>

                                <!-- 右：Z 竖排 -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Button cal:Message.Attach="JogAkribisL('Z', 1)" Content="Z+"
                                            Style="{StaticResource DPadBtn}" Background="#2ECC71"/>
                                    <Button cal:Message.Attach="JogAkribisL('Z', -1)" Content="Z−"
                                            Style="{StaticResource DPadBtn}" Background="#95A5A6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 5. 雅克贝斯 R D-Pad -->
                    <Border Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding AkribisRDisplay}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>

                            <Grid HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左：当前位置（竖排） -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0"
                                            Visibility="{Binding HasAkribisRPos, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding AkribisRPosXText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding AkribisRPosYText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding AkribisRPosZText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>

                                <!-- 中：十字（XY） -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="1" cal:Message.Attach="JogAkribisR('Y', 1)"
                                            Content="▲" Style="{StaticResource DPadBtn}" Background="#3498DB"/>
                                    <Button Grid.Row="1" Grid.Column="0" cal:Message.Attach="JogAkribisR('X', -1)"
                                            Content="◀" Style="{StaticResource DPadBtn}" Background="#E74C3C"/>
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Content="●" Style="{StaticResource DPadBtn}" Background="#BDC3C7" IsEnabled="False"/>
                                    <Button Grid.Row="1" Grid.Column="2" cal:Message.Attach="JogAkribisR('X', 1)"
                                            Content="▶" Style="{StaticResource DPadBtn}" Background="#27AE60"/>
                                    <Button Grid.Row="2" Grid.Column="1" cal:Message.Attach="JogAkribisR('Y', -1)"
                                            Content="▼" Style="{StaticResource DPadBtn}" Background="#E67E22"/>
                                </Grid>

                                <!-- 右：Z 竖排 -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Button cal:Message.Attach="JogAkribisR('Z', 1)" Content="Z+"
                                            Style="{StaticResource DPadBtn}" Background="#2ECC71"/>
                                    <Button cal:Message.Attach="JogAkribisR('Z', -1)" Content="Z−"
                                            Style="{StaticResource DPadBtn}" Background="#95A5A6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 6. 夹爪控制 -->
                    <Border Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="夹爪控制" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>

                            <!-- 夹爪 L -->
                            <Border Background="{StaticResource AccentLightBrush}"
                                    CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding GripperLPosText}" FontSize="11"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" cal:Message.Attach="JogGripperL(-1)"
                                            Content="关闭" Style="{StaticResource DPadBtn}" Width="44"
                                            Background="#E74C3C" Margin="0,0,4,0"/>
                                    <Button Grid.Column="2" cal:Message.Attach="JogGripperL(1)"
                                            Content="打开" Style="{StaticResource DPadBtn}" Width="44"
                                            Background="#27AE60"/>
                                </Grid>
                            </Border>

                            <!-- 夹爪 R -->
                            <Border Background="{StaticResource AccentLightBrush}"
                                    CornerRadius="6" Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding GripperRPosText}" FontSize="11"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" cal:Message.Attach="JogGripperR(-1)"
                                            Content="关闭" Style="{StaticResource DPadBtn}" Width="44"
                                            Background="#E74C3C" Margin="0,0,4,0"/>
                                    <Button Grid.Column="2" cal:Message.Attach="JogGripperR(1)"
                                            Content="打开" Style="{StaticResource DPadBtn}" Width="44"
                                            Background="#27AE60"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- 运动中遮罩：运动未完成前拦截所有 D-Pad 按钮点击 -->
                <Border Background="Transparent"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
