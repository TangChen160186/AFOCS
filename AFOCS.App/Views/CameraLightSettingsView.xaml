<UserControl x:Class="AFOCS.App.Views.CameraLightSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:viewModels="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="460"
             d:DataContext="{d:DesignInstance viewModels:CameraLightSettingsViewModel}"
             IsTabStop="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#EF4444" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,5">
            <!-- ========== 连接状态 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="相机光源" FontWeight="Bold" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ConnectedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button cal:Message.Attach="DisconnectAsync"
                                Width="60" Padding="6,3" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            断开
                        </Button>
                        <Button cal:Message.Attach="ReconnectAsync"
                                Width="60" Padding="6,3">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            重连
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 连接配置 ========== -->
            <TextBlock Text="连接配置" FontWeight="Bold" Margin="0,0,0,6" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Label Width="60" Content="串口号:" FontSize="11" VerticalAlignment="Center" />
                <Button Content="扫描" cal:Message.Attach="ScanPortsAsync"
                        Width="44" Height="22" FontSize="10" Padding="4,2">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ProgressBar Width="50" Height="10" IsIndeterminate="True" Margin="4,0,4,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>

            <ComboBox ItemsSource="{Binding AvailablePorts}"
                      Text="{Binding PortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      Margin="60,0,0,4" Width="130" Height="22" FontSize="11"
                      HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Label Width="60" Content="波特率:" FontSize="11" VerticalAlignment="Center" />
                <TextBox Width="80" FontSize="11"
                         Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- ========== 通道亮度控制 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="通道亮度控制" FontWeight="Bold" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:LightChannelInfo}">
                                <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                       FontSize="12" Width="50" VerticalAlignment="Center" />
                                            <Slider Width="180" Minimum="0" Maximum="255"
                                                    Value="{Binding Brightness, Delay=30}"
                                                    SmallChange="1" LargeChange="16"
                                                    VerticalAlignment="Center" Margin="6,0" />
                                            <TextBox Width="40" FontSize="11"
                                                     Text="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center" TextAlignment="Center"
                                                     Margin="4,0,4,0" />
                                            <TextBlock Text="(0-255)" FontSize="10" Foreground="Gray"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Content="设置" Width="48" Height="22"
                                                    FontSize="10" Padding="4,2"
                                                    cal:Message.Attach="SetChannelBrightnessAsync($dataContext)">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock FontSize="10" Foreground="Gray"
                                                   Margin="50,0,0,0">
                                            <Run Text="已应用: " />
                                            <Run Text="{Binding AppliedBrightness}" FontWeight="Bold" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 底部进度条 -->
            <ProgressBar Height="6" IsIndeterminate="True" Margin="0,8,0,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource EnvironmentWindowText}"
                       Opacity="0.7" FontSize="12">
                修改串口配置后点击 OK 保存配置，点击重连使新配置生效。
                拖动滑块调整各通道亮度（0-255），点击"设置"应用到设备。
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
