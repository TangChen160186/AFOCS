<UserControl x:Class="AFOCS.App.Views.OpticalPowerMeterRightSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:viewModels="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="460"
             d:DataContext="{d:DesignInstance viewModels:OpticalPowerMeterRightSettingsViewModel}"
             IsTabStop="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#EF4444" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,5">
            <!-- ========== 连接状态 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ConnectedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="连接状态:" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                   FontWeight="Bold" Margin="4,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button cal:Message.Attach="SaveAsync"
                                Width="50" Height="22" FontSize="10"
                                Padding="4,2" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            保存
                        </Button>
                        <Button cal:Message.Attach="ReconnectAsync"
                                Width="50" Height="22" FontSize="10" Padding="4,2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            重连
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部进度条 -->
            <ProgressBar Height="6" IsIndeterminate="True" Margin="0,8,0,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <!-- ========== 连接配置 ========== -->
            <TextBlock Text="连接配置" FontWeight="Bold" Margin="0,0,0,6" />

            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <Label Width="90" Content="IP 地址:" VerticalAlignment="Center" />
                <TextBox Width="180" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Label Width="90" Content="端口:" VerticalAlignment="Center" />
                <TextBox Width="80" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Label Width="90" Content="超时时间(ms):" VerticalAlignment="Center" />
                <TextBox Width="80" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- ========== Slot/Channel ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                    Padding="0,8,0,0" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Label Width="90" Content="Slot:" VerticalAlignment="Center" />
                    <TextBox Width="60" Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Width="60" Content="Channel:" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox Width="60" Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <!-- ========== OS 光源 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                    Padding="0,8,0,0" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="OS 光源" FontWeight="Bold" FontSize="13"
                               Margin="0,0,0,6" Foreground="#6366F1" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="功率:" VerticalAlignment="Center" FontSize="11" />
                            <TextBlock Text="{Binding OsPowerRead, StringFormat={}{0:F3}}"
                                       VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource ConnectedBrush}" Margin="4,0,0,0" />
                            <TextBlock Text=" mW" VerticalAlignment="Center" FontSize="11"
                                       Margin="2,0,8,0" />
                            <TextBlock Text="状态:" VerticalAlignment="Center" FontSize="11" />
                            <TextBlock Text="{Binding OsStatus}" VerticalAlignment="Center"
                                       FontSize="14" FontWeight="Bold" Margin="4,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="读取" Width="50" Height="22"
                                FontSize="10" cal:Message.Attach="ReadOsAsync">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="设置:" VerticalAlignment="Center" FontSize="11"
                                   Margin="0,0,4,0" />
                        <TextBox Width="70" FontSize="11"
                                 Text="{Binding OsPowerSet, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=" mW" VerticalAlignment="Center" FontSize="11"
                                   Margin="2,0,6,0" />
                        <Button Content="设置" Width="50" Height="22"
                                FontSize="10" cal:Message.Attach="SetOsPowerAsync">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========== OPM 功率计 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                    Padding="0,8,0,0" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="OPM 功率计" FontWeight="Bold" FontSize="13"
                               Margin="0,0,0,6" Foreground="#F59E0B" />

                    <!-- 功率 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="功率:" VerticalAlignment="Center" FontSize="11" />
                            <TextBlock Text="{Binding OpmPowerRead, StringFormat={}{0:F3}}"
                                       VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource ConnectedBrush}" Margin="4,0,0,0" />
                            <TextBlock Text=" dBm" VerticalAlignment="Center" FontSize="11"
                                       Margin="2,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="读取功率" Width="65" Height="22"
                                FontSize="10" cal:Message.Attach="ReadOpmPowerAsync">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- 偏移 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="偏移:" VerticalAlignment="Center" FontSize="11" />
                            <TextBlock Text="{Binding OpmOffsetRead, StringFormat={}{0:F3}}"
                                       VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                       Margin="4,0,0,0" />
                            <TextBlock Text=" dB" VerticalAlignment="Center" FontSize="11"
                                       Margin="2,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="读取偏移" Width="65" Height="22"
                                FontSize="10" cal:Message.Attach="ReadOpmOffsetAsync">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="设置:" VerticalAlignment="Center" FontSize="11"
                                   Margin="0,0,4,0" />
                        <TextBox Width="70" FontSize="11"
                                 Text="{Binding OpmOffsetSet, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=" dB" VerticalAlignment="Center" FontSize="11"
                                   Margin="2,0,6,0" />
                        <Button Content="设置" Width="50" Height="22"
                                FontSize="10" cal:Message.Attach="SetOpmOffsetAsync">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>


            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource EnvironmentWindowText}"
                       Opacity="0.7" FontSize="12">
                修改后点击 OK 保存连接配置。Slot/Channel 用于指定操作的目标槽位和通道。
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
