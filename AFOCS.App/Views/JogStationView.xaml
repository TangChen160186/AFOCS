<UserControl x:Class="AFOCS.App.Views.JogStationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:vm="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:JogStationViewModel}"
             Background="#F3F3F3">

    <UserControl.Resources>
        <!-- ===== 亮色主题颜色 ===== -->
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0078D4"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="DigitalBg" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="DigitalText" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="SectionBg" Color="#FAFAFA"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ===== Jog 按钮模板 ===== -->
        <Style x:Key="JogBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnFastRev" TargetType="Button" BasedOn="{StaticResource JogBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Content" Value="◀◀"/>
        </Style>
        <Style x:Key="BtnSlowRev" TargetType="Button" BasedOn="{StaticResource JogBtn}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Content" Value="◀"/>
        </Style>
        <Style x:Key="BtnStop" TargetType="Button" BasedOn="{StaticResource JogBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Content" Value="■"/>
            <Setter Property="Width" Value="28"/>
        </Style>
        <Style x:Key="BtnSlowFwd" TargetType="Button" BasedOn="{StaticResource JogBtn}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Content" Value="▶"/>
        </Style>
        <Style x:Key="BtnFastFwd" TargetType="Button" BasedOn="{StaticResource JogBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Content" Value="▶▶"/>
        </Style>
        <Style x:Key="BtnHome" TargetType="Button" BasedOn="{StaticResource JogBtn}">
            <Setter Property="Background" Value="#6B7280"/>
            <Setter Property="Content" Value="H"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ===== 步长输入 ===== -->
        <Style x:Key="StepInput" TargetType="TextBox">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===== 工位选择器 ===== -->
        <Style x:Key="StationCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- ===== 组头 ===== -->
        <Style x:Key="GroupHdr" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- ===== Tab 头部 ===== -->
        <Style x:Key="TabHdr" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EBEBEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部：Tab + 工位选择器 ===== -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TabControl BorderThickness="0" Background="Transparent"
                            ItemContainerStyle="{StaticResource TabHdr}"
                            SelectionChanged="OnTabSelectionChanged">
                    <TabItem Header="总线轴 (EtherCAT)"/>
                    <TabItem Header="雅克贝斯 (Akribis)"/>
                    <TabItem Header="夹爪 (SMC)"/>
                </TabControl>

                <!-- 工位筛选 -->
                <Border Grid.Column="1" Padding="8,4" Margin="0,2,4,2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="工位:" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding StationOptions}"
                                  SelectedItem="{Binding SelectedStation}"
                                  Style="{StaticResource StationCombo}" Width="90"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 内容区 ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ======== 总线轴 Tab 内容 ======== -->
                <StackPanel x:Name="BusPanel">
                    <!-- 步长设置 -->
                    <Border Background="White"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                            Padding="10,7">
                        <WrapPanel>
                            <TextBlock Text="步长:" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="粗调" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding BusJogStepLarge, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StepInput}" Margin="0,0,12,0"/>
                            <TextBlock Text="微调" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding BusJogStepSmall, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StepInput}"/>
                        </WrapPanel>
                    </Border>

                    <!-- 轴列表（按工位筛选 + 分组） -->
                    <ItemsControl ItemsSource="{Binding FilteredBusAxisGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource GroupHdr}"/>
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White"
                                                        BorderBrush="{StaticResource CardBorder}"
                                                        BorderThickness="0,0,0,1" Padding="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="115"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 名称 + 状态 -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <Border CornerRadius="6" Padding="8,2">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEmergencyStop}" Value="True">
                                                                                    <Setter Property="Background" Value="#DC2626"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                                    <Setter Property="Background" Value="#F97316"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                                    <Setter Property="Background" Value="#16A34A"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                    <Setter Property="Background" Value="#9CA3AF"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="White"/>
                                                                </Border>

                                                                <Border Background="#FEF3C7" CornerRadius="3"
                                                                        Padding="4,2" Margin="2,0,0,0"
                                                                        Visibility="{Binding IsNegativeLimit, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="NEL" FontSize="9" Foreground="#D97706" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Border Background="#FEF3C7" CornerRadius="3"
                                                                        Padding="4,2" Margin="2,0,0,0"
                                                                        Visibility="{Binding IsPositiveLimit, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="PEL" FontSize="9" Foreground="#D97706" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- 位置读数 -->
                                                        <Border Grid.Column="2" Background="{StaticResource DigitalBg}"
                                                                CornerRadius="4" Padding="8,3" Margin="6,0"
                                                                HorizontalAlignment="Right" MinWidth="72"
                                                                BorderBrush="#E5E5E5" BorderThickness="1">
                                                            <TextBlock Text="{Binding Position, StringFormat={}{0:F2}}"
                                                                       FontFamily="Consolas" FontSize="14"
                                                                       Foreground="{StaticResource DigitalText}"
                                                                       HorizontalAlignment="Right"/>
                                                        </Border>

                                                        <!-- Jog 按钮 -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <Button Style="{StaticResource BtnFastRev}"
                                                                    cal:Message.Attach="BusJogMinusLargeAsync($dataContext)"/>
                                                            <Button Style="{StaticResource BtnSlowRev}"
                                                                    cal:Message.Attach="BusJogMinusSmallAsync($dataContext)"/>
                                                            <Button Style="{StaticResource BtnStop}"
                                                                    cal:Message.Attach="BusStopAsync($dataContext)"/>
                                                            <Button Style="{StaticResource BtnHome}"
                                                                    cal:Message.Attach="BusHomeAsync($dataContext)"/>
                                                            <Button Style="{StaticResource BtnSlowFwd}"
                                                                    cal:Message.Attach="BusJogPlusSmallAsync($dataContext)"/>
                                                            <Button Style="{StaticResource BtnFastFwd}"
                                                                    cal:Message.Attach="BusJogPlusLargeAsync($dataContext)"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ======== 雅克贝斯 Tab 内容 ======== -->
                <StackPanel x:Name="AkribisPanel" Visibility="Collapsed">
                    <!-- 步长设置 -->
                    <Border Background="White"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                            Padding="10,7">
                        <WrapPanel>
                            <TextBlock Text="步长:" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="粗调" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding AkribisJogStepLarge, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StepInput}" Margin="0,0,12,0"/>
                            <TextBlock Text="微调" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding AkribisJogStepSmall, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StepInput}"/>
                        </WrapPanel>
                    </Border>

                    <!-- 工位卡片 -->
                    <ItemsControl ItemsSource="{Binding FilteredAkribisStations}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="12,10" Margin="2,4">
                                    <StackPanel>
                                        <!-- 标题栏 -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" CornerRadius="8" Padding="10,3" Background="#DCFCE7">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                    <Setter Property="Text" Value="已连接"/>
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                    <Setter Property="Text" Value="未连接"/>
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,0,0,8"/>

                                        <!-- X 轴 -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#DC2626" CornerRadius="4"
                                                    Width="22" Height="22" HorizontalAlignment="Center">
                                                <TextBlock Text="X" FontSize="12" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource DigitalBg}"
                                                    CornerRadius="4" Padding="8,3" Margin="6,0"
                                                    HorizontalAlignment="Right" MinWidth="65"
                                                    BorderBrush="#E5E5E5" BorderThickness="1">
                                                <TextBlock Text="{Binding PosX, StringFormat={}{0:N0}}"
                                                           FontFamily="Consolas" FontSize="14"
                                                           Foreground="{StaticResource DigitalText}"
                                                           HorizontalAlignment="Right"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource BtnFastRev}"
                                                        cal:Message.Attach="AkribisJogMinusLargeAsync($dataContext, 'X')"/>
                                                <Button Style="{StaticResource BtnSlowRev}"
                                                        cal:Message.Attach="AkribisJogMinusSmallAsync($dataContext, 'X')"/>
                                                <Button Style="{StaticResource BtnStop}"
                                                        cal:Message.Attach="AkribisStopAsync($dataContext)"/>
                                                <Button Style="{StaticResource BtnHome}"
                                                        cal:Message.Attach="AkribisHomeAsync($dataContext, 'X')"/>
                                                <Button Style="{StaticResource BtnSlowFwd}"
                                                        cal:Message.Attach="AkribisJogPlusSmallAsync($dataContext, 'X')"/>
                                                <Button Style="{StaticResource BtnFastFwd}"
                                                        cal:Message.Attach="AkribisJogPlusLargeAsync($dataContext, 'X')"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Y 轴 -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#16A34A" CornerRadius="4"
                                                    Width="22" Height="22" HorizontalAlignment="Center">
                                                <TextBlock Text="Y" FontSize="12" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource DigitalBg}"
                                                    CornerRadius="4" Padding="8,3" Margin="6,0"
                                                    HorizontalAlignment="Right" MinWidth="65"
                                                    BorderBrush="#E5E5E5" BorderThickness="1">
                                                <TextBlock Text="{Binding PosY, StringFormat={}{0:N0}}"
                                                           FontFamily="Consolas" FontSize="14"
                                                           Foreground="{StaticResource DigitalText}"
                                                           HorizontalAlignment="Right"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource BtnFastRev}"
                                                        cal:Message.Attach="AkribisJogMinusLargeAsync($dataContext, 'Y')"/>
                                                <Button Style="{StaticResource BtnSlowRev}"
                                                        cal:Message.Attach="AkribisJogMinusSmallAsync($dataContext, 'Y')"/>
                                                <Button Style="{StaticResource BtnStop}"
                                                        cal:Message.Attach="AkribisStopAsync($dataContext)"/>
                                                <Button Style="{StaticResource BtnHome}"
                                                        cal:Message.Attach="AkribisHomeAsync($dataContext, 'Y')"/>
                                                <Button Style="{StaticResource BtnSlowFwd}"
                                                        cal:Message.Attach="AkribisJogPlusSmallAsync($dataContext, 'Y')"/>
                                                <Button Style="{StaticResource BtnFastFwd}"
                                                        cal:Message.Attach="AkribisJogPlusLargeAsync($dataContext, 'Y')"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Z 轴 -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#2563EB" CornerRadius="4"
                                                    Width="22" Height="22" HorizontalAlignment="Center">
                                                <TextBlock Text="Z" FontSize="12" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource DigitalBg}"
                                                    CornerRadius="4" Padding="8,3" Margin="6,0"
                                                    HorizontalAlignment="Right" MinWidth="65"
                                                    BorderBrush="#E5E5E5" BorderThickness="1">
                                                <TextBlock Text="{Binding PosZ, StringFormat={}{0:N0}}"
                                                           FontFamily="Consolas" FontSize="14"
                                                           Foreground="{StaticResource DigitalText}"
                                                           HorizontalAlignment="Right"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource BtnFastRev}"
                                                        cal:Message.Attach="AkribisJogMinusLargeAsync($dataContext, 'Z')"/>
                                                <Button Style="{StaticResource BtnSlowRev}"
                                                        cal:Message.Attach="AkribisJogMinusSmallAsync($dataContext, 'Z')"/>
                                                <Button Style="{StaticResource BtnStop}"
                                                        cal:Message.Attach="AkribisStopAsync($dataContext)"/>
                                                <Button Style="{StaticResource BtnHome}"
                                                        cal:Message.Attach="AkribisHomeAsync($dataContext, 'Z')"/>
                                                <Button Style="{StaticResource BtnSlowFwd}"
                                                        cal:Message.Attach="AkribisJogPlusSmallAsync($dataContext, 'Z')"/>
                                                <Button Style="{StaticResource BtnFastFwd}"
                                                        cal:Message.Attach="AkribisJogPlusLargeAsync($dataContext, 'Z')"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ======== 夹爪 Tab 内容 ======== -->
                <StackPanel x:Name="GripperPanel" Visibility="Collapsed">
                    <!-- 公共参数设置 -->
                    <Border Background="White"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                            Padding="10,7">
                        <WrapPanel>
                            <TextBlock Text="速度:" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding GripperSpeed, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StepInput}" Width="50" Margin="0,0,12,0"/>
                            <TextBlock Text="目标位置:" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding GripperTargetPosition, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StepInput}" Width="50"/>
                            <TextBlock Text=" (0-400)" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"/>
                        </WrapPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding FilteredGrippers}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="12,10" Margin="2,4">
                                    <StackPanel>
                                        <!-- 标题栏 -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>

                                            <!-- 状态指示 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Border CornerRadius="8" Padding="10,3" Margin="2,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,0,0,8"/>

                                        <!-- 位置显示 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="当前位置:" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                                            <Border Grid.Column="1" Background="{StaticResource DigitalBg}"
                                                    CornerRadius="4" Padding="8,3"
                                                    HorizontalAlignment="Right" MinWidth="65"
                                                    BorderBrush="#E5E5E5" BorderThickness="1">
                                                <TextBlock FontFamily="Consolas" FontSize="16"
                                                           Foreground="{StaticResource DigitalText}"
                                                           HorizontalAlignment="Right">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} / 400">
                                                            <Binding Path="Position"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <!-- 操作按钮行 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource BtnHome}"
                                                    cal:Message.Attach="GripperHomeAsync($dataContext)"
                                                    Width="70" Height="30" FontSize="12">
                                            </Button>
                                            <Button Style="{StaticResource JogBtn}" Width="56" Height="30"
                                                    Background="#16A34A" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                    Margin="4,0" Content="使能"
                                                    cal:Message.Attach="GripperEnableAsync($dataContext)"/>
                                            <Button Style="{StaticResource JogBtn}" Width="70" Height="30"
                                                    Background="#F97316" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                    Margin="4,0" Content="报警复位"
                                                    cal:Message.Attach="GripperAlarmResetAsync($dataContext)"/>
                                            <Button Style="{StaticResource JogBtn}" Width="56" Height="30"
                                                    Background="#0078D4" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                    Margin="4,0" Content="动作"
                                                    cal:Message.Attach="GripperMoveAsync($dataContext)"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 底部状态栏（精简） ===== -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Border CornerRadius="3" Padding="8,2" Background="#F97316"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="BUSY" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="错误信息通过弹窗提示" FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
