<UserControl x:Class="AFOCS.App.Views.FaPdCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:vm="clr-namespace:AFOCS.App.ViewModels"
             xmlns:models="clr-namespace:AFOCS.App.Models"
             xmlns:infrastructure="clr-namespace:AFOCS.Infrastructure;assembly=AFOCS.Infrastructure"
             xmlns:converter="clr-namespace:AFOCS.App.Converter"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FaPdCalibrationViewModel}"
             Background="#F3F3F3">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converter:EnumToCollectionConverter x:Key="EnumToCollection"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>

            <!-- ===== 基础配置 ===== -->
            <Border Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="基础配置" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                    <TextBlock Text="工位:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding Converter={StaticResource EnumToCollection}, ConverterParameter={x:Type infrastructure:WorkPos}}"
                             DisplayMemberPath="Description"
                             SelectedValuePath="Value"
                             SelectedValue="{Binding SelectedStation}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="88"/>
                                <Setter Property="Height" Value="30"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="Background" Value="{StaticResource CardBorder}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Text="测高方向轴:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,4"/>
                    <ComboBox ItemsSource="{Binding Converter={StaticResource EnumToCollection}, ConverterParameter={x:Type models:EAxis}}"
                              DisplayMemberPath="Description"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedAxis}"
                              Height="30" FontSize="12" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ===== 标定操作 ===== -->
            <Border Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="标定操作" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                    <TextBlock Text="标定示教点:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding TeachingPoints}"
                                  SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Height="30" FontSize="12" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" cal:Message.Attach="LoadTeachingPointsAsync" Content="刷新"
                                Width="52" Height="30" FontSize="11" Margin="6,0,0,0" Padding="0"/>
                    </Grid>

                    <Button cal:Message.Attach="MoveToTeachingPoint" Content="运动到示教点"
                            Height="30" FontSize="12" Margin="0,8,0,0" Padding="0"
                            Foreground="White" Background="{StaticResource AccentBrush}" BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="相机:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,4"/>
                    <ComboBox ItemsSource="{Binding CameraNames}"
                              SelectedItem="{Binding SelectedCameraName, Mode=TwoWay}"
                              Height="30" FontSize="12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="视觉模板:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TemplatePath, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" FontSize="11" VerticalContentAlignment="Center"
                                 Padding="4,0"/>
                        <Button Grid.Column="1" cal:Message.Attach="BrowseTemplate" Content="浏览"
                                Width="52" Height="30" FontSize="11" Margin="6,0,0,0" Padding="0"/>
                    </Grid>

                    <TextBlock Text="测高仪通道:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,4"/>
                    <ComboBox ItemsSource="{Binding Channels}"
                              SelectedItem="{Binding Channel}"
                              Width="120" Height="30" FontSize="12" HorizontalAlignment="Left"/>

                    <Button cal:Message.Attach="CalibrateAsync" Content="开始标定"
                            Height="34" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" Padding="0"
                            Foreground="White" Background="{StaticResource SuccessBrush}" BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ===== 标定结果 ===== -->
            <Border Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,6"
                    Visibility="{Binding IsCalibrated, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="标定结果" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="轴位置 P0:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CalibAxisPosition, StringFormat={}{0:F4}}" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="测高值 H0:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CalibHeight, StringFormat={}{0:F4}}" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="像素 X:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CalibPixelX, StringFormat={}{0:F2}}" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="像素 Y:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CalibPixelY, StringFormat={}{0:F2}}" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="相机精度:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CalibPrecision, StringFormat={}{0:F6}}" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 状态 ===== -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
