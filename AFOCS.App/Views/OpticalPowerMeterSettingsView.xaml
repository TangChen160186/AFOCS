<UserControl x:Class="AFOCS.App.Views.OpticalPowerMeterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:viewModels="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="460"
             d:DataContext="{d:DesignInstance viewModels:OpticalPowerMeterSettingsViewModel}"
             IsTabStop="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#EF4444" />

        <DataTemplate x:Key="SideTemplate" DataType="{x:Type viewModels:OpmSideInfo}">
            <Border BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <!-- 标题 + 状态 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Ellipse Width="10" Height="10" Margin="0,0,4,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource ConnectedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                       FontSize="11" Foreground="Gray" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button cal:Message.Attach="DisconnectAsync"
                                    Width="50" Height="22" FontSize="10"
                                    Padding="4,2" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                断开
                            </Button>
                            <Button cal:Message.Attach="ReconnectAsync"
                                    Width="50" Height="22" FontSize="10" Padding="4,2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                重连
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- IP 配置 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Label Width="30" Content="IP:" FontSize="11" VerticalAlignment="Center" />
                        <TextBox Width="130" FontSize="11"
                                 Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Width="40" Content="端口:" FontSize="11" VerticalAlignment="Center" />
                        <TextBox Width="80" FontSize="11"
                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Slot / Channel -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <Label Width="30" Content="Slot:" FontSize="11" VerticalAlignment="Center" />
                        <TextBox Width="40" FontSize="11"
                                 Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Width="55" Content="Channel:" FontSize="11" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                        <TextBox Width="40" FontSize="11"
                                 Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- OS 光源 -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                            Padding="0,6,0,0" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="OS 光源" FontWeight="Bold" FontSize="12"
                                       Margin="0,0,0,4" Foreground="#6366F1" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="功率:" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Text="{Binding OsPowerRead, StringFormat={}{0:F3}}"
                                               VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource ConnectedBrush}" Margin="4,0,0,0" />
                                    <TextBlock Text=" mW" VerticalAlignment="Center" FontSize="11"
                                               Margin="2,0,8,0" />
                                    <TextBlock Text="状态:" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Text="{Binding OsStatus}" VerticalAlignment="Center"
                                               FontSize="14" FontWeight="Bold" Margin="4,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="读取" Width="50" Height="22"
                                        FontSize="10" cal:Message.Attach="ReadOsAsync">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="设置:" VerticalAlignment="Center" FontSize="11"
                                           Margin="0,0,4,0" />
                                <TextBox Width="70" FontSize="11"
                                         Text="{Binding OsPowerSet, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text=" mW" VerticalAlignment="Center" FontSize="11"
                                           Margin="2,0,6,0" />
                                <Button Content="设置" Width="50" Height="22"
                                        FontSize="10" cal:Message.Attach="SetOsPowerAsync">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- OPM 功率计 -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                            Padding="0,6,0,0" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="OPM 功率计" FontWeight="Bold" FontSize="12"
                                       Margin="0,0,0,4" Foreground="#F59E0B" />

                            <!-- 功率 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="功率:" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Text="{Binding OpmPowerRead, StringFormat={}{0:F3}}"
                                               VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource ConnectedBrush}" Margin="4,0,0,0" />
                                    <TextBlock Text=" dBm" VerticalAlignment="Center" FontSize="11"
                                               Margin="2,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="读取功率" Width="65" Height="22"
                                        FontSize="10" cal:Message.Attach="ReadOpmPowerAsync">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- 偏移 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="偏移:" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Text="{Binding OpmOffsetRead, StringFormat={}{0:F3}}"
                                               VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                               Margin="4,0,0,0" />
                                    <TextBlock Text=" dB" VerticalAlignment="Center" FontSize="11"
                                               Margin="2,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="读取偏移" Width="65" Height="22"
                                        FontSize="10" cal:Message.Attach="ReadOpmOffsetAsync">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="偏移:" VerticalAlignment="Center" FontSize="11"
                                           Margin="0,0,4,0" />
                                <TextBox Width="70" FontSize="11"
                                         Text="{Binding OpmOffsetSet, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text=" dB" VerticalAlignment="Center" FontSize="11"
                                           Margin="2,0,6,0" />
                                <Button Content="设置" Width="50" Height="22"
                                        FontSize="10" cal:Message.Attach="SetOpmOffsetAsync">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 进度条 -->
                    <ProgressBar Height="10" IsIndeterminate="True" Margin="0,4,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,5">
            <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource SideTemplate}" />
            <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource SideTemplate}" />

            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource EnvironmentWindowText}"
                       Opacity="0.7" FontSize="12">
                修改后点击 OK 保存连接配置。Slot/Channel 用于指定操作的目标槽位和通道。
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
