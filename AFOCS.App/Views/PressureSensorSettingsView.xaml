<UserControl x:Class="AFOCS.App.Views.PressureSensorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:viewModels="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="460"
             d:DataContext="{d:DesignInstance viewModels:PressureSensorSettingsViewModel}"
             IsTabStop="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SectionBg" Color="#FFF3F4F6" />
        <SolidColorBrush x:Key="LabelFg" Color="#FF6B7280" />
        <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="AlarmBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="NormalBrush" Color="#10B981" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,5">

            <!-- ========== 传感器名称 & 状态 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ConnectedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource LabelFg}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========== 实时压力值 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="实时压力值" FontWeight="Bold" />
                        <Button cal:Message.Attach="RefreshValuesAsync"
                                Content="刷新" Width="50" Padding="6,2" Margin="12,0,0,0"
                                FontSize="11" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- X -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="X 通道" Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ValueX}" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="8" Height="8" Margin="6,0,0,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource NormalBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmActiveX}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AlarmBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </StackPanel>

                        <!-- Y -->
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="Y 通道" Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ValueY}" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="8" Height="8" Margin="6,0,0,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource NormalBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmActiveY}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AlarmBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </StackPanel>

                        <!-- Z -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Z 通道" Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ValueZ}" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="8" Height="8" Margin="6,0,0,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource NormalBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmActiveZ}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AlarmBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== 清零校准 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="清零校准" FontWeight="Bold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button cal:Message.Attach="ZeroXAsync" Content="X 清零" Width="65" Padding="6,3" Margin="0,0,6,0" />
                        <Button cal:Message.Attach="ZeroYAsync" Content="Y 清零" Width="65" Padding="6,3" Margin="0,0,6,0" />
                        <Button cal:Message.Attach="ZeroZAsync" Content="Z 清零" Width="65" Padding="6,3" Margin="0,0,6,0" />
                        <Button cal:Message.Attach="ZeroAllAsync" Content="全部清零" Width="75" Padding="6,3" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========== 从站地址 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="从站地址" FontWeight="Bold" Margin="0,0,0,6" />
                    <DockPanel>
                        <TextBlock Text="Slave Address" VerticalAlignment="Center" Width="90"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding SlaveAddress, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                 VerticalContentAlignment="Center" Height="24" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ========== 通道映射 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="通道映射（通道 → OD 子索引）" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="修改此映射可以交换 X/Y/Z 的物理接线对应关系"
                               Foreground="{StaticResource LabelFg}" FontSize="11" Margin="0,0,0,8" />

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="X 通道 →" VerticalAlignment="Center" Width="60"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding MapX, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                 VerticalContentAlignment="Center" Height="24" />
                        <TextBlock Text="(默认=1)" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource LabelFg}" FontSize="10" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Y 通道 →" VerticalAlignment="Center" Width="60"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding MapY, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                 VerticalContentAlignment="Center" Height="24" />
                        <TextBlock Text="(默认=2)" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource LabelFg}" FontSize="10" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Z 通道 →" VerticalAlignment="Center" Width="60"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding MapZ, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                 VerticalContentAlignment="Center" Height="24" />
                        <TextBlock Text="(默认=3)" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource LabelFg}" FontSize="10" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ========== 报警阈值 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="报警阈值（0 = 禁用报警）" FontWeight="Bold" Margin="0,0,0,6" />

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="X 通道" VerticalAlignment="Center" Width="60"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding AlarmX, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                 VerticalContentAlignment="Center" Height="24" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Y 通道" VerticalAlignment="Center" Width="60"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding AlarmY, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                 VerticalContentAlignment="Center" Height="24" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Z 通道" VerticalAlignment="Center" Width="60"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding AlarmZ, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                 VerticalContentAlignment="Center" Height="24" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ========== 保存 ========== -->
            <Button cal:Message.Attach="SaveAsync"
                    Content="保存配置" Width="100" Padding="8,5"
                    HorizontalAlignment="Left" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
