<base:CameraToolViewBase x:Class="AFOCS.App.Views.RightUpCameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:AFOCS.App.Views"
             xmlns:halconDotNet="clr-namespace:HalconDotNet;assembly=halcondotnet">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FAFAFA" Padding="8,4"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="2,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#D32F2F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#2E7D32" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock FontSize="12" Foreground="#888" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="未连接" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Text" Value="已连接" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding LastResultText}" FontSize="12" Foreground="#333"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <halconDotNet:HSmartWindowControlWPF x:Name="HWindowControl" />
    </DockPanel>
</base:CameraToolViewBase>
