<UserControl x:Class="AFOCS.App.Views.IOMappingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="550"
             d:DataContext="{d:DesignInstance viewModels:IOMappingSettingsViewModel}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="OnBrush" Color="#FF22C55E" />
        <SolidColorBrush x:Key="OffBrush" Color="#FF6B7280" />

        <viewModels:BoolToBrushConverter x:Key="BoolToBrush"
                                          OnBrush="{StaticResource OnBrush}"
                                          OffBrush="{StaticResource OffBrush}" />

        <!-- 输入信号分组 -->
        <CollectionViewSource x:Key="InputGrouped" Source="{Binding InputItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Module" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- 输出信号分组 -->
        <CollectionViewSource x:Key="OutputGrouped" Source="{Binding OutputItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Module" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- 输入行：状态灯 + 名称 + 位号 -->
        <DataTemplate x:Key="InputRowTemplate">
            <Grid Margin="2,1" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{Binding IsHigh, Converter={StaticResource BoolToBrush}}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="#FF374151" Margin="4,0,0,0"
                           ToolTip="{Binding SignalName}" />
                <TextBox Grid.Column="2" Text="{Binding BitNo, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="11" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         Width="44" Height="20" />
            </Grid>
        </DataTemplate>

        <!-- 输出行：名称 + 状态按钮 + 位号 -->
        <DataTemplate x:Key="OutputRowTemplate">
            <Grid Margin="2,1" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="#FF374151"
                           ToolTip="{Binding SignalName}" />
                <Button Grid.Column="1" Width="32" Height="18"
                        Command="{Binding DataContext.ToggleOutputCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding SignalName}"
                        FontSize="9" Padding="0" BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF6B7280" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Content" Value="OFF" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                    <Setter Property="Background" Value="#FF22C55E" />
                                    <Setter Property="Content" Value="ON" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBox Grid.Column="2" Text="{Binding BitNo, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="11" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         Width="44" Height="20" />
            </Grid>
        </DataTemplate>

        <!-- 分组标题 -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                       FontSize="11" Foreground="#FF6B7280"
                       Margin="4,6,0,2" />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 顶栏：状态 + 按钮 -->
        <Border DockPanel.Dock="Top" Padding="6,5" Background="#FFF9FAFB"
                BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource OffBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="监控中">
                                        <Setter Property="Fill" Value="{StaticResource OnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="保存" Command="{Binding SaveCommand}" Width="56" Height="22"
                            FontSize="11" Background="#FF059669" Foreground="White"
                            BorderThickness="0" />
                    <Button Content="默认" Command="{Binding ResetDefaultCommand}" Width="56" Height="22"
                            FontSize="11" Margin="4,0,0,0"
                            Background="#FFE5E7EB" Foreground="#FF374151" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 信号列表 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">
                <!-- 输入信号 -->
                <Expander Header="输入信号" IsExpanded="True" FontWeight="Bold" FontSize="12"
                          Margin="0,0,0,4">
                    <ItemsControl ItemsSource="{Binding Source={StaticResource InputGrouped}}"
                                  ItemTemplate="{StaticResource InputRowTemplate}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </Expander>

                <!-- 输出信号 -->
                <Expander Header="输出信号" IsExpanded="True" FontWeight="Bold" FontSize="12">
                    <ItemsControl ItemsSource="{Binding Source={StaticResource OutputGrouped}}"
                                  ItemTemplate="{StaticResource OutputRowTemplate}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
