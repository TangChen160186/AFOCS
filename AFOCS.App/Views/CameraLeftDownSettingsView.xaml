<UserControl x:Class="AFOCS.App.Views.CameraLeftDownSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:viewModels="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="380" d:DesignWidth="460"
             d:DataContext="{d:DesignInstance viewModels:CameraLeftDownSettingsViewModel}"
             IsTabStop="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#EF4444" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,5">
            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ConnectedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button cal:Message.Attach="SaveAsync"
                                Width="60" Padding="6,3" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            保存
                        </Button>
                        <Button cal:Message.Attach="ReconnectAsync" Width="60" Padding="6,3">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            重连
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="连接配置" FontWeight="Bold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <Label Width="90" Content="序列号:" VerticalAlignment="Center" />
                <TextBox Width="280" Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Label Width="90" VerticalAlignment="Center" />
                <Button Content="扫描可用相机" cal:Message.Attach="ScanAvailableCameras" Width="110" Padding="6,3">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ProgressBar Width="120" Height="14" Margin="8,0,0,0" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
            <ComboBox Margin="90,4,0,0" Width="280" HorizontalAlignment="Left"
                      ItemsSource="{Binding AvailableCameras}"
                      cal:Message.Attach="[Event SelectionChanged] = [Action SelectCamera($eventArgs)]">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding .}" FontWeight="Bold" Margin="0,0,8,0" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- ========== 实时预览 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="实时预览" FontWeight="Bold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="分辨率:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ConnectedBrush}">
                            <Run Text="{Binding Width, Mode=OneWay}" />
                            <Run Text=" x " />
                            <Run Text="{Binding Height, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform"
                           MaxWidth="440" MaxHeight="330"
                           Margin="0,8,0,0" />

                    <Button Content="抓取当前图像" Width="100" Height="28"
                            FontSize="12" Margin="0,8,0,0"
                            cal:Message.Attach="CaptureAsync" />
                </StackPanel>
            </Border>
            <ProgressBar Height="6" IsIndeterminate="True" Margin="0,8,0,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource EnvironmentWindowText}"
                       Opacity="0.7" FontSize="12">
                修改序列号后点击 OK 保存配置，点击重连使新配置生效。
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
