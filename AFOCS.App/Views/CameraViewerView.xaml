<base:CameraToolViewBase x:Class="AFOCS.App.Views.CameraViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:AFOCS.App.Views"
             xmlns:halconDotNet="clr-namespace:HalconDotNet;assembly=halcondotnet">
    <DockPanel>
        <!-- 顶部：相机下拉切换 + 连接状态 -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" Padding="8,6"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="相机:" Foreground="#888" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CameraNames}"
                          SelectedItem="{Binding SelectedCamera}" VerticalAlignment="Center"
                          MaxDropDownHeight="200" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="2,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D32F2F" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#2E7D32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" Foreground="#888" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="未连接" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="已连接" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <!-- 实时图像窗口（右键可保存 PNG） -->
        <halconDotNet:HSmartWindowControlWPF x:Name="HWindowControl" />
    </DockPanel>
</base:CameraToolViewBase>
