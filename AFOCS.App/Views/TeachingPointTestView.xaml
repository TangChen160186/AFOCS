<UserControl x:Class="AFOCS.App.Views.TeachingPointTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:vm="clr-namespace:AFOCS.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TeachingPointTestViewModel}"
             Background="#F3F3F3">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>

            <!-- ===== 示教点选择 ===== -->
            <Border Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="示教点运动测试" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>

                    <TextBlock Text="选择示教点:" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding TeachingPoints}"
                              SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Height="30" FontSize="12"
                              VerticalContentAlignment="Center"/>

                    <Button cal:Message.Attach="LoadTeachingPointsAsync" Content="刷新列表"
                            Width="70" Height="24" FontSize="11" Margin="0,6,0,0"
                            Padding="0"/>

                    <!-- 示教点信息 -->
                    <Border Background="#F8F8F8" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
                            Visibility="{Binding IsPointSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PointAxisInfo}" FontSize="11"
                                   Foreground="#555555" TextWrapping="Wrap"/>
                    </Border>

                    <!-- 运动按钮 -->
                    <Button cal:Message.Attach="MoveToTeachingPoint"
                            Content="运动到示教点"
                            Width="120" Height="32" FontSize="12" FontWeight="SemiBold"
                            Margin="0,10,0,0" Padding="0"
                            Foreground="White" Background="{StaticResource AccentBrush}" BorderThickness="0"
                            IsEnabled="{Binding IsPointSelected}" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- 运动中进度 -->
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                                 Visibility="{Binding IsMoving, Converter={StaticResource BoolToVis}}"/>

                    <!-- 状态 -->
                    <TextBlock Text="{Binding MoveStatus}" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
