<UserControl x:Class="AFOCS.App.Views.Settings.AkribisCouplingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:settings="clr-namespace:AFOCS.App.ViewModels.Settings"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="460"
             d:DataContext="{d:DesignInstance settings:AkribisCouplingSettingsBase}"
             IsTabStop="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SectionBg" Color="#FFF3F4F6" />
        <SolidColorBrush x:Key="LabelFg" Color="#FF6B7280" />
        <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#EF4444" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,5">

            <!-- ========== 名称 & 状态 ========== -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ConnectedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource LabelFg}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========== 实时位置 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="实时位置" FontWeight="Bold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="X 轴" Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <TextBlock FontSize="18" FontWeight="Bold"
                                       Text="{Binding PositionX, StringFormat=N0}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Y 轴" Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <TextBlock FontSize="18" FontWeight="Bold"
                                       Text="{Binding PositionY, StringFormat=N0}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Z 轴" Foreground="{StaticResource LabelFg}" FontSize="11" />
                            <TextBlock FontSize="18" FontWeight="Bold"
                                       Text="{Binding PositionZ, StringFormat=N0}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== 连接参数 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="连接参数" FontWeight="Bold" Margin="0,0,0,8" />
                    <DockPanel Margin="0,2">
                        <TextBlock Text="IP 地址" VerticalAlignment="Center" Width="70"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}"
                                 Width="140" HorizontalAlignment="Left" Height="24"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>
                    <CheckBox Content="启用 ARK"
                              IsChecked="{Binding Ark}" Margin="0,6,0,0" />
                    <CheckBox Content="自动重连"
                              IsChecked="{Binding AutoReconnect}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ========== 轴参数 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="轴参数" FontWeight="Bold" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding AxisList}"
                                  SelectedItem="{Binding SelectedAxis, Mode=TwoWay}"
                                  Width="50" HorizontalAlignment="Right" Height="24" />
                    </DockPanel>
                    <UniformGrid Columns="2" Rows="2">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="速度" FontSize="11"
                                       Foreground="{StaticResource LabelFg}" />
                            <TextBox Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" HorizontalAlignment="Left" Height="24"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="加速度" FontSize="11"
                                       Foreground="{StaticResource LabelFg}" />
                            <TextBox Text="{Binding Accel, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" HorizontalAlignment="Left" Height="24"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="减速度" FontSize="11"
                                       Foreground="{StaticResource LabelFg}" />
                            <TextBox Text="{Binding Decel, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" HorizontalAlignment="Left" Height="24"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ========== 操作按钮 ========== -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button cal:Message.Attach="SaveAsync"
                        Content="保存" Width="60" Padding="6,3" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModify}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button cal:Message.Attach="Reset"
                        Content="恢复默认" Width="70" Padding="6,3" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button cal:Message.Attach="ReconnectAsync"
                        Content="重连" Width="50" Padding="6,3" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ProgressBar Width="60" Height="6" IsIndeterminate="True" Margin="8,0,0,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>

            <!-- ========== 运动测试 ========== -->
            <Border Background="{StaticResource SectionBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="运动测试" FontWeight="Bold" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding TestAxisList}"
                                  SelectedItem="{Binding TestAxis, Mode=TwoWay}"
                                  Width="50" HorizontalAlignment="Right" Height="24" />
                    </DockPanel>

                    <!-- Jog 距离 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="步长" VerticalAlignment="Center" Width="40"
                                   Foreground="{StaticResource LabelFg}" FontSize="11" />
                        <TextBox Text="{Binding TestDistance, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" HorizontalAlignment="Left" Height="24"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>

                    <!-- Jog 按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button cal:Message.Attach="JogMinusAsync"
                                Content="◀ 反向" Width="80" Padding="6,4" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button cal:Message.Attach="JogPlusAsync"
                                Content="正向 ▶" Width="80" Padding="6,4" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button cal:Message.Attach="TestStopAsync"
                                Content="停止" Width="60" Padding="6,4" Margin="0,0,8,0"
                                Background="#F59E0B" Foreground="White"
                                BorderBrush="#F59E0B">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="#F59E0B" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#F59E0B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- 使能 / 关使能 / 回零 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button cal:Message.Attach="TestEnableAsync"
                                Content="使能" Width="60" Padding="4,3" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button cal:Message.Attach="TestDisEnableAsync"
                                Content="关使能" Width="60" Padding="4,3" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button cal:Message.Attach="TestHomeAsync"
                                Content="回零" Width="60" Padding="4,3" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- 急停 -->
                    <StackPanel Orientation="Horizontal">
                        <Button cal:Message.Attach="TestEmergencyStopAsync"
                                Content="急停此轴" Width="80" Padding="4,3" Margin="0,0,8,0"
                                Background="#DC2626" Foreground="White"
                                BorderBrush="#DC2626">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="#DC2626" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#DC2626" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button cal:Message.Attach="TestEmergencyStopAllAsync"
                                Content="全轴急停" Width="80" Padding="4,3"
                                Background="#DC2626" Foreground="White"
                                BorderBrush="#DC2626">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="#DC2626" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#DC2626" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreConnected}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
